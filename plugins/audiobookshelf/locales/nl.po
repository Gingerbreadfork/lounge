# Lounge, audiobookshelf: nl
#
msgid ""
msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Add a username and password, or an API key, in the plugin's settings."
msgstr "Voeg in de instellingen van de plug-in een gebruikersnaam en wachtwoord toe, of een API-sleutel."

#: src/lib.rs
msgid "Audiobookshelf rejected the username or password. Check them in the plugin's settings."
msgstr "Audiobookshelf heeft de gebruikersnaam of het wachtwoord geweigerd. Controleer ze in de instellingen van de plug-in."

#: src/lib.rs
msgid "Audiobookshelf didn't accept the API key. Check it in the plugin's settings, or make a new one."
msgstr "Audiobookshelf heeft de API-sleutel niet geaccepteerd. Controleer de sleutel in de instellingen van de plug-in of maak een nieuwe aan."

#: src/lib.rs
msgid "Audiobookshelf is turning sign-ins away after too many tries. Wait a few minutes, then try again."
msgstr "Audiobookshelf laat je na te veel pogingen even niet inloggen. Wacht een paar minuten en probeer het dan opnieuw."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Audiobookshelf no longer has that. Press Refresh now on the plugin's page to bring its rows up to date."
msgstr "Audiobookshelf heeft dat niet meer. Druk op de pagina van de plug-in op Nu vernieuwen om de rijen bij te werken."

#: src/lib.rs
msgid "Continue listening and what's new on your Audiobookshelf server, played in a player app such as VLC, though your place on the server doesn't move when you listen on the TV."
msgstr "Verder luisteren en wat er nieuw is op je Audiobookshelf-server, afgespeeld in een afspeel-app zoals VLC. Je positie op de server schuift niet mee als je op de tv luistert."

#: src/lib.rs
msgid "Recently added on Audiobookshelf"
msgstr "Onlangs toegevoegd op Audiobookshelf"

#: src/lib.rs
msgid "New episodes on Audiobookshelf"
msgstr "Nieuwe afleveringen op Audiobookshelf"

#: src/lib.rs
msgid "Server address"
msgstr "Serveradres"

#: src/lib.rs
msgid "Like http://192.168.0.10:13378"
msgstr "Bijvoorbeeld http://192.168.0.10:13378"

#: src/lib.rs
msgid "Username"
msgstr "Gebruikersnaam"

#: src/lib.rs
msgid "Leave it empty when you use an API key instead."
msgstr "Laat dit leeg als je in plaats daarvan een API-sleutel gebruikt."

#: src/lib.rs
msgid "Password"
msgstr "Wachtwoord"

#: src/lib.rs
msgid "API key"
msgstr "API-sleutel"

#. "Settings" and "API Keys" are pages of Audiobookshelf's own website.
#: src/lib.rs
msgid "Instead of a username and password. An admin makes one in Audiobookshelf under Settings, then API Keys, and it is easiest pasted from the phone companion."
msgstr "In plaats van gebruikersnaam en wachtwoord. Een beheerder maakt er een in Audiobookshelf onder Settings, API Keys; plakken kan via Lounge op je telefoon."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "serveradres"

#. {show} is a podcast's name and {length} how long the episode runs, such as "48 minutes".
#: src/lib.rs
msgid "{show}, {length}"
msgstr "{show}, {length}"

#: src/lib.rs
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} uur"
msgstr[1] "{n} uur"

#: src/lib.rs
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuut"
msgstr[1] "{n} minuten"

#. a length of time. {hours} is a count of hours, such as "2 hours", and {minutes} a count of minutes, such as "25 minutes".
#: src/lib.rs
msgid "{hours} {minutes}"
msgstr "{hours} {minutes}"

#. {series} is the name of a series of books and {number} this book's place in it, such as 2.
#: src/lib.rs
msgid "{series}, book {number}"
msgstr "{series}, boek {number}"
