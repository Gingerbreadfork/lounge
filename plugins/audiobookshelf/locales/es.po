# Lounge, audiobookshelf: es
#
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Add a username and password, or an API key, in the plugin's settings."
msgstr "Añade un nombre de usuario y una contraseña, o una clave de API, en los ajustes del plugin."

#: src/lib.rs
msgid "Audiobookshelf rejected the username or password. Check them in the plugin's settings."
msgstr "Audiobookshelf rechazó el nombre de usuario o la contraseña. Compruébalos en los ajustes del plugin."

#: src/lib.rs
msgid "Audiobookshelf didn't accept the API key. Check it in the plugin's settings, or make a new one."
msgstr "Audiobookshelf no aceptó la clave de API. Compruébala en los ajustes del plugin o crea una nueva."

#: src/lib.rs
msgid "Audiobookshelf is turning sign-ins away after too many tries. Wait a few minutes, then try again."
msgstr "Audiobookshelf está rechazando los inicios de sesión tras demasiados intentos. Espera unos minutos y vuelve a intentarlo."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Audiobookshelf no longer has that. Press Refresh now on the plugin's page to bring its rows up to date."
msgstr "Audiobookshelf ya no tiene eso. Pulsa Actualizar ahora en la página del plugin para poner al día sus filas."

#: src/lib.rs
msgid "Continue listening and what's new on your Audiobookshelf server, played in a player app such as VLC, though your place on the server doesn't move when you listen on the TV."
msgstr "Seguir escuchando y las novedades de tu servidor Audiobookshelf, en una app de reproducción como VLC, aunque tu posición en el servidor no avanza cuando escuchas en la TV."

#: src/lib.rs
msgid "Recently added on Audiobookshelf"
msgstr "Añadido recientemente en Audiobookshelf"

#: src/lib.rs
msgid "New episodes on Audiobookshelf"
msgstr "Episodios nuevos en Audiobookshelf"

#: src/lib.rs
msgid "Server address"
msgstr "Dirección del servidor"

#: src/lib.rs
msgid "Like http://192.168.0.10:13378"
msgstr "Por ejemplo, http://192.168.0.10:13378"

#: src/lib.rs
msgid "Username"
msgstr "Nombre de usuario"

#: src/lib.rs
msgid "Leave it empty when you use an API key instead."
msgstr "Déjalo vacío si usas una clave de API."

#: src/lib.rs
msgid "Password"
msgstr "Contraseña"

#: src/lib.rs
msgid "API key"
msgstr "Clave de API"

#. "Settings" and "API Keys" are pages of Audiobookshelf's own website.
#: src/lib.rs
msgid "Instead of a username and password. An admin makes one in Audiobookshelf under Settings, then API Keys, and it is easiest pasted from the phone companion."
msgstr "En vez de usuario y contraseña. Un administrador la crea en Audiobookshelf, en Settings y luego API Keys; lo más fácil es pegarla desde Lounge en el teléfono."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "dirección del servidor"

#. {show} is a podcast's name and {length} how long the episode runs, such as "48 minutes".
#: src/lib.rs
msgid "{show}, {length}"
msgstr "{show}, {length}"

#: src/lib.rs
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/lib.rs
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#. a length of time. {hours} is a count of hours, such as "2 hours", and {minutes} a count of minutes, such as "25 minutes".
#: src/lib.rs
msgid "{hours} {minutes}"
msgstr "{hours} y {minutes}"

#. {series} is the name of a series of books and {number} this book's place in it, such as 2.
#: src/lib.rs
msgid "{series}, book {number}"
msgstr "{series}, libro {number}"
