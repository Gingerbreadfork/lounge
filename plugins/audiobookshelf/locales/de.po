# Lounge, audiobookshelf: de
#
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Add a username and password, or an API key, in the plugin's settings."
msgstr "Trage in den Plugin-Einstellungen Benutzername und Passwort oder einen API-Schlüssel ein."

#: src/lib.rs
msgid "Audiobookshelf rejected the username or password. Check them in the plugin's settings."
msgstr "Audiobookshelf hat Benutzername oder Passwort abgelehnt. Prüfe beides in den Plugin-Einstellungen."

#: src/lib.rs
msgid "Audiobookshelf didn't accept the API key. Check it in the plugin's settings, or make a new one."
msgstr "Audiobookshelf hat den API-Schlüssel nicht akzeptiert. Prüfe ihn in den Plugin-Einstellungen oder erstelle einen neuen."

#: src/lib.rs
msgid "Audiobookshelf is turning sign-ins away after too many tries. Wait a few minutes, then try again."
msgstr "Audiobookshelf weist Anmeldungen nach zu vielen Versuchen ab. Warte ein paar Minuten und versuche es dann erneut."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Audiobookshelf no longer has that. Press Refresh now on the plugin's page to bring its rows up to date."
msgstr "Das gibt es bei Audiobookshelf nicht mehr. Drücke auf der Seite des Plugins „Jetzt aktualisieren“, um seine Reihen auf den neuesten Stand zu bringen."

#: src/lib.rs
msgid "Continue listening and what's new on your Audiobookshelf server, played in a player app such as VLC, though your place on the server doesn't move when you listen on the TV."
msgstr "Weiterhören und Neues von deinem Audiobookshelf-Server, abgespielt in einer Player-App wie VLC. Hörst du am Fernseher, bleibt deine Position auf dem Server allerdings stehen."

#: src/lib.rs
msgid "Recently added on Audiobookshelf"
msgstr "Kürzlich hinzugefügt auf Audiobookshelf"

#: src/lib.rs
msgid "New episodes on Audiobookshelf"
msgstr "Neue Folgen auf Audiobookshelf"

#: src/lib.rs
msgid "Server address"
msgstr "Serveradresse"

#: src/lib.rs
msgid "Like http://192.168.0.10:13378"
msgstr "Zum Beispiel http://192.168.0.10:13378"

#: src/lib.rs
msgid "Username"
msgstr "Benutzername"

#: src/lib.rs
msgid "Leave it empty when you use an API key instead."
msgstr "Lass das Feld leer, wenn du stattdessen einen API-Schlüssel verwendest."

#: src/lib.rs
msgid "Password"
msgstr "Passwort"

#: src/lib.rs
msgid "API key"
msgstr "API-Schlüssel"

#. "Settings" and "API Keys" are pages of Audiobookshelf's own website.
#: src/lib.rs
msgid "Instead of a username and password. An admin makes one in Audiobookshelf under Settings, then API Keys, and it is easiest pasted from the phone companion."
msgstr "Anstelle von Benutzername und Passwort. Ein Admin erstellt ihn in Audiobookshelf unter „Einstellungen“, dann „API Keys“. Am einfachsten fügst du ihn über Lounge fürs Handy ein."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "Serveradresse"

#. {show} is a podcast's name and {length} how long the episode runs, such as "48 minutes".
#: src/lib.rs
msgid "{show}, {length}"
msgstr "{show}, {length}"

#: src/lib.rs
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} Stunde"
msgstr[1] "{n} Stunden"

#: src/lib.rs
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} Minute"
msgstr[1] "{n} Minuten"

#. a length of time. {hours} is a count of hours, such as "2 hours", and {minutes} a count of minutes, such as "25 minutes".
#: src/lib.rs
msgid "{hours} {minutes}"
msgstr "{hours} {minutes}"

#. {series} is the name of a series of books and {number} this book's place in it, such as 2.
#: src/lib.rs
msgid "{series}, book {number}"
msgstr "{series}, Band {number}"
