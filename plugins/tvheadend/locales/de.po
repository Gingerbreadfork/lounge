# Lounge, tvheadend: de
#
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Live channels, the guide and your recordings from a Tvheadend server."
msgstr "Live-Sender, TV-Programm und deine Aufnahmen von einem Tvheadend-Server."

#: src/lib.rs
msgid "Recordings on Tvheadend"
msgstr "Aufnahmen auf Tvheadend"

#: src/lib.rs
msgid "Server address"
msgstr "Serveradresse"

#: src/lib.rs
msgid "Like http://192.168.0.10:9981"
msgstr "Zum Beispiel http://192.168.0.10:9981"

#: src/lib.rs
msgid "Username"
msgstr "Benutzername"

#: src/lib.rs
msgid "Leave both empty if the server allows anonymous access."
msgstr "Lass beide Felder leer, wenn der Server anonymen Zugriff erlaubt."

#: src/lib.rs
msgid "Password"
msgstr "Passwort"

#: src/lib.rs
msgid "Persistent auth token"
msgstr "Dauerhaftes Auth-Token"

#. Configuration, Users, Access entries and Persistent authentication are names in Tvheadend's own menus.
#: src/lib.rs
msgid "Lets the TV play streams without a password. In Tvheadend go to Configuration, Users, Access entries, open your user and turn on Persistent authentication; the token appears there."
msgstr "Damit spielt der Fernseher Streams ohne Passwort ab. Gehe in Tvheadend zu „Configuration“, „Users“, „Access entries“, öffne deinen Benutzer und schalte „Persistent authentication“ ein; das Token erscheint dort."

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "Stream profile"
msgstr "Stream-Profil"

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "A profile from Configuration, Stream. The default, pass, sends the channel as it is."
msgstr "Ein Profil aus „Configuration“, „Stream“. Das Standardprofil pass gibt den Sender unverändert weiter."

#: src/lib.rs
msgid "Only channels tagged"
msgstr "Nur Sender mit dem Tag"

#: src/lib.rs
msgid "A channel tag name such as TV. Empty means every enabled channel."
msgstr "Der Name eines Sender-Tags, zum Beispiel TV. Leer heißt: alle aktivierten Sender."

#: src/lib.rs
msgid "Tvheadend has no enabled channels. Map some services to channels in Tvheadend first."
msgstr "Tvheadend hat keine aktivierten Sender. Ordne zuerst in Tvheadend ein paar Dienste Sendern zu."

#. {algorithm} is a technical name as the server sent it, such as SHA-256.
#: src/lib.rs
msgid "Tvheadend asks for Digest sign-in with {algorithm}, which the plugin cannot answer. In Tvheadend's general settings, set the digest hash type to MD5."
msgstr "Tvheadend verlangt eine Digest-Anmeldung mit {algorithm}, die das Plugin nicht beantworten kann. Stelle in den allgemeinen Einstellungen von Tvheadend den Digest-Hash-Typ auf MD5."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "Serveradresse"

#: src/lib.rs
msgid "Tvheadend refused this user. Check that its access entry allows the web interface."
msgstr "Tvheadend hat diesen Benutzer abgelehnt. Prüfe, ob sein Zugangseintrag die Weboberfläche erlaubt."

#: src/lib.rs
msgid "Tvheadend wants a username and password. Enter them in the plugin's settings."
msgstr "Tvheadend verlangt Benutzername und Passwort. Trage beides in den Plugin-Einstellungen ein."

#: src/lib.rs
msgid "Tvheadend refused the request without saying how to sign in. In Tvheadend's general settings, check the authentication type."
msgstr "Tvheadend hat die Anfrage abgelehnt, ohne zu sagen, wie man sich anmeldet. Prüfe in den allgemeinen Einstellungen von Tvheadend die Art der Authentifizierung."

#: src/lib.rs
msgid "Tvheadend rejected the username or password. Check them in the plugin's settings."
msgstr "Tvheadend hat Benutzername oder Passwort abgelehnt. Prüfe beides in den Plugin-Einstellungen."

#: src/lib.rs
msgid "Tvheadend has no channel tag called \"{name}\". Check the tag's name in the plugin's settings."
msgstr "Tvheadend hat kein Sender-Tag namens „{name}“. Prüfe den Namen des Tags in den Plugin-Einstellungen."

#. {when} is a phrase such as "On now" or "Starts in 20 minutes", and {channel} is a channel's name.
#: src/lib.rs
msgid "{when}, {channel}"
msgstr "{when}, {channel}"

#. said of a programme that is being broadcast at this moment.
#: src/lib.rs
msgid "On now"
msgstr "Läuft gerade"

#: src/lib.rs
msgid "Starts in {n} minute"
msgid_plural "Starts in {n} minutes"
msgstr[0] "Beginnt in {n} Minute"
msgstr[1] "Beginnt in {n} Minuten"

#: src/lib.rs
msgid "Starts in {n} hour"
msgid_plural "Starts in {n} hours"
msgstr[0] "Beginnt in {n} Stunde"
msgstr[1] "Beginnt in {n} Stunden"

#: src/lib.rs
msgid "Starts in {n} day"
msgid_plural "Starts in {n} days"
msgstr[0] "Beginnt in {n} Tag"
msgstr[1] "Beginnt in {n} Tagen"
