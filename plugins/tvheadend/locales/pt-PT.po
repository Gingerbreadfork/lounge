# Lounge, tvheadend: pt-PT
#
msgid ""
msgstr ""
"Language: pt-PT\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Live channels, the guide and your recordings from a Tvheadend server."
msgstr "Canais em direto, o guia e as suas gravações de um servidor Tvheadend."

#: src/lib.rs
msgid "Recordings on Tvheadend"
msgstr "Gravações no Tvheadend"

#: src/lib.rs
msgid "Server address"
msgstr "Endereço do servidor"

#: src/lib.rs
msgid "Like http://192.168.0.10:9981"
msgstr "Por exemplo, http://192.168.0.10:9981"

#: src/lib.rs
msgid "Username"
msgstr "Nome de utilizador"

#: src/lib.rs
msgid "Leave both empty if the server allows anonymous access."
msgstr "Deixe ambos vazios se o servidor permitir acesso anónimo."

#: src/lib.rs
msgid "Password"
msgstr "Palavra-passe"

#: src/lib.rs
msgid "Persistent auth token"
msgstr "Token de autenticação persistente"

#. Configuration, Users, Access entries and Persistent authentication are names in Tvheadend's own menus.
#: src/lib.rs
msgid "Lets the TV play streams without a password. In Tvheadend go to Configuration, Users, Access entries, open your user and turn on Persistent authentication; the token appears there."
msgstr "Permite à TV reproduzir streams sem palavra-passe. No Tvheadend, vá a Configuração, Utilizadores, Permissões de acesso, abra o seu utilizador e ative Persistent authentication; o token aparece lá."

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "Stream profile"
msgstr "Perfil de transmissão"

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "A profile from Configuration, Stream. The default, pass, sends the channel as it is."
msgstr "Um perfil de Configuração, Transmissão. O predefinido, pass, envia o canal tal como está."

#: src/lib.rs
msgid "Only channels tagged"
msgstr "Só canais com a etiqueta"

#: src/lib.rs
msgid "A channel tag name such as TV. Empty means every enabled channel."
msgstr "O nome de uma etiqueta de canal, como TV. Vazio significa todos os canais ativados."

#: src/lib.rs
msgid "Tvheadend has no enabled channels. Map some services to channels in Tvheadend first."
msgstr "O Tvheadend não tem canais ativados. Mapeie primeiro alguns serviços para canais no Tvheadend."

#. {algorithm} is a technical name as the server sent it, such as SHA-256.
#: src/lib.rs
msgid "Tvheadend asks for Digest sign-in with {algorithm}, which the plugin cannot answer. In Tvheadend's general settings, set the digest hash type to MD5."
msgstr "O Tvheadend pede início de sessão Digest com {algorithm}, a que o plugin não consegue responder. Nas definições gerais do Tvheadend, defina o tipo de hash do Digest como MD5."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "endereço do servidor"

#: src/lib.rs
msgid "Tvheadend refused this user. Check that its access entry allows the web interface."
msgstr "O Tvheadend recusou este utilizador. Verifique se a permissão de acesso dele permite a interface web."

#: src/lib.rs
msgid "Tvheadend wants a username and password. Enter them in the plugin's settings."
msgstr "O Tvheadend pede um nome de utilizador e uma palavra-passe. Introduza-os nas definições do plugin."

#: src/lib.rs
msgid "Tvheadend refused the request without saying how to sign in. In Tvheadend's general settings, check the authentication type."
msgstr "O Tvheadend recusou o pedido sem indicar como iniciar sessão. Nas definições gerais do Tvheadend, verifique o tipo de autenticação."

#: src/lib.rs
msgid "Tvheadend rejected the username or password. Check them in the plugin's settings."
msgstr "O Tvheadend rejeitou o nome de utilizador ou a palavra-passe. Verifique-os nas definições do plugin."

#: src/lib.rs
msgid "Tvheadend has no channel tag called \"{name}\". Check the tag's name in the plugin's settings."
msgstr "O Tvheadend não tem nenhuma etiqueta de canal chamada «{name}». Verifique o nome da etiqueta nas definições do plugin."

#. {when} is a phrase such as "On now" or "Starts in 20 minutes", and {channel} is a channel's name.
#: src/lib.rs
msgid "{when}, {channel}"
msgstr "{when}, {channel}"

#. said of a programme that is being broadcast at this moment.
#: src/lib.rs
msgid "On now"
msgstr "A dar agora"

#: src/lib.rs
msgid "Starts in {n} minute"
msgid_plural "Starts in {n} minutes"
msgstr[0] "Começa daqui a {n} minuto"
msgstr[1] "Começa daqui a {n} minutos"

#: src/lib.rs
msgid "Starts in {n} hour"
msgid_plural "Starts in {n} hours"
msgstr[0] "Começa daqui a {n} hora"
msgstr[1] "Começa daqui a {n} horas"

#: src/lib.rs
msgid "Starts in {n} day"
msgid_plural "Starts in {n} days"
msgstr[0] "Começa daqui a {n} dia"
msgstr[1] "Começa daqui a {n} dias"
