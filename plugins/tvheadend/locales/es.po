# Lounge, tvheadend: es
#
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Live channels, the guide and your recordings from a Tvheadend server."
msgstr "Canales en directo, la guía y tus grabaciones de un servidor Tvheadend."

#: src/lib.rs
msgid "Recordings on Tvheadend"
msgstr "Grabaciones en Tvheadend"

#: src/lib.rs
msgid "Server address"
msgstr "Dirección del servidor"

#: src/lib.rs
msgid "Like http://192.168.0.10:9981"
msgstr "Por ejemplo, http://192.168.0.10:9981"

#: src/lib.rs
msgid "Username"
msgstr "Nombre de usuario"

#: src/lib.rs
msgid "Leave both empty if the server allows anonymous access."
msgstr "Deja ambos vacíos si el servidor permite el acceso anónimo."

#: src/lib.rs
msgid "Password"
msgstr "Contraseña"

#: src/lib.rs
msgid "Persistent auth token"
msgstr "Token de autenticación persistente"

#. Configuration, Users, Access entries and Persistent authentication are names in Tvheadend's own menus.
#: src/lib.rs
msgid "Lets the TV play streams without a password. In Tvheadend go to Configuration, Users, Access entries, open your user and turn on Persistent authentication; the token appears there."
msgstr "Permite que la TV reproduzca las transmisiones sin contraseña. En Tvheadend ve a Configuration, Users, Access entries, abre tu usuario y activa Persistent authentication; el token aparece allí."

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "Stream profile"
msgstr "Perfil de transmisión"

#. a setting and its help. Configuration and Stream are menus in Tvheadend, and pass is a profile's name, kept as it is.
#: src/lib.rs
msgid "A profile from Configuration, Stream. The default, pass, sends the channel as it is."
msgstr "Un perfil de Configuration, Stream. El predeterminado, pass, envía el canal tal cual."

#: src/lib.rs
msgid "Only channels tagged"
msgstr "Solo canales con la etiqueta"

#: src/lib.rs
msgid "A channel tag name such as TV. Empty means every enabled channel."
msgstr "El nombre de una etiqueta de canales, como TV. Si lo dejas vacío, se usan todos los canales habilitados."

#: src/lib.rs
msgid "Tvheadend has no enabled channels. Map some services to channels in Tvheadend first."
msgstr "Tvheadend no tiene canales habilitados. Asigna primero algunos servicios a canales en Tvheadend."

#. {algorithm} is a technical name as the server sent it, such as SHA-256.
#: src/lib.rs
msgid "Tvheadend asks for Digest sign-in with {algorithm}, which the plugin cannot answer. In Tvheadend's general settings, set the digest hash type to MD5."
msgstr "Tvheadend pide un inicio de sesión Digest con {algorithm}, que el plugin no puede atender. En los ajustes generales de Tvheadend, pon el tipo de hash de Digest en MD5."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "dirección del servidor"

#: src/lib.rs
msgid "Tvheadend refused this user. Check that its access entry allows the web interface."
msgstr "Tvheadend rechazó a este usuario. Comprueba que su entrada de acceso permita la interfaz web."

#: src/lib.rs
msgid "Tvheadend wants a username and password. Enter them in the plugin's settings."
msgstr "Tvheadend pide un nombre de usuario y una contraseña. Escríbelos en los ajustes del plugin."

#: src/lib.rs
msgid "Tvheadend refused the request without saying how to sign in. In Tvheadend's general settings, check the authentication type."
msgstr "Tvheadend rechazó la solicitud sin decir cómo iniciar sesión. En los ajustes generales de Tvheadend, comprueba el tipo de autenticación."

#: src/lib.rs
msgid "Tvheadend rejected the username or password. Check them in the plugin's settings."
msgstr "Tvheadend rechazó el nombre de usuario o la contraseña. Compruébalos en los ajustes del plugin."

#: src/lib.rs
msgid "Tvheadend has no channel tag called \"{name}\". Check the tag's name in the plugin's settings."
msgstr "Tvheadend no tiene ninguna etiqueta de canales llamada «{name}». Comprueba el nombre de la etiqueta en los ajustes del plugin."

#. {when} is a phrase such as "On now" or "Starts in 20 minutes", and {channel} is a channel's name.
#: src/lib.rs
msgid "{when}, {channel}"
msgstr "{when}, {channel}"

#. said of a programme that is being broadcast at this moment.
#: src/lib.rs
msgid "On now"
msgstr "En emisión"

#: src/lib.rs
msgid "Starts in {n} minute"
msgid_plural "Starts in {n} minutes"
msgstr[0] "Empieza en {n} minuto"
msgstr[1] "Empieza en {n} minutos"

#: src/lib.rs
msgid "Starts in {n} hour"
msgid_plural "Starts in {n} hours"
msgstr[0] "Empieza en {n} hora"
msgstr[1] "Empieza en {n} horas"

#: src/lib.rs
msgid "Starts in {n} day"
msgid_plural "Starts in {n} days"
msgstr[0] "Empieza en {n} día"
msgstr[1] "Empieza en {n} días"
