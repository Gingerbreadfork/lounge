msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Over-the-air channels and a guide from an HDHomeRun tuner on your network."
msgstr "Antennensender und TV-Programm von einem HDHomeRun-Tuner in deinem Netzwerk."

#: src/lib.rs
msgid "Tuner address"
msgstr "Tuner-Adresse"

#: src/lib.rs
msgid "Leave it empty and the tuner is found automatically. Otherwise use its address, like http://192.168.0.20."
msgstr "Lass das Feld leer, dann wird der Tuner automatisch gefunden. Sonst trage seine Adresse ein, zum Beispiel http://192.168.0.20."

#: src/lib.rs
msgid "Hide channels marked DRM"
msgstr "Sender mit DRM ausblenden"

#: src/lib.rs
msgid "They cannot play outside HDHomeRun's own app."
msgstr "Sie laufen nur in der App von HDHomeRun."

#: src/lib.rs
msgid "No HDHomeRun answered at {address}. Check the tuner and its address, then try again."
msgstr "Unter {address} hat kein HDHomeRun geantwortet. Prüfe den Tuner und seine Adresse und versuche es dann erneut."

#: src/lib.rs
msgid "The HDHomeRun at {address} didn't send its channels. Check the tuner, then try again."
msgstr "Der HDHomeRun unter {address} hat seine Sender nicht geschickt. Prüfe den Tuner und versuche es dann erneut."

#. {tuner} is the name the tuner gives itself, such as HDHomeRun FLEX 4K.
#: src/lib.rs
msgid "{tuner} has no channels yet. Run a channel scan in the HDHomeRun app first."
msgstr "{tuner} hat noch keine Sender. Starte zuerst in der HDHomeRun-App einen Sendersuchlauf."

#: src/lib.rs
msgid "The tuner has no channels yet. Run a channel scan in the HDHomeRun app first."
msgstr "Der Tuner hat noch keine Sender. Starte zuerst in der HDHomeRun-App einen Sendersuchlauf."

#: src/lib.rs
msgid "Could not look for tuners. Check the TV's internet connection, or enter the tuner's address in the plugin's settings."
msgstr "Die Suche nach Tunern ist fehlgeschlagen. Prüfe die Internetverbindung des Fernsehers oder trage die Adresse des Tuners in den Plugin-Einstellungen ein."

#: src/lib.rs
msgid "No HDHomeRun tuner was found on this network. Enter its address in the plugin's settings."
msgstr "In diesem Netzwerk wurde kein HDHomeRun-Tuner gefunden. Trage seine Adresse in den Plugin-Einstellungen ein."
