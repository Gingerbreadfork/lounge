# Lounge, trakt: pt-BR
#
msgid ""
msgstr ""
"Language: pt-BR\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Trakt no longer accepts this sign-in; it is renewed on the next refresh, or press Refresh now."
msgstr "O Trakt não aceita mais este login; ele é renovado na próxima atualização, ou pressione Atualizar agora."

#: src/lib.rs
msgid "Trakt is asking for a pause between requests. It tries again on the next refresh."
msgstr "O Trakt está pedindo uma pausa entre os pedidos. Vai tentar de novo na próxima atualização."

#: src/lib.rs
msgid "Continue watching, up next and your watchlist from Trakt, across every service."
msgstr "Continuar assistindo, a seguir e a sua watchlist do Trakt, de todos os serviços."

#: src/lib.rs
msgid "Up next on Trakt"
msgstr "A seguir no Trakt"

#: src/lib.rs
msgid "Watchlist on Trakt"
msgstr "Watchlist no Trakt"

#: src/lib.rs
msgid "Client ID"
msgstr "Client ID"

#: src/lib.rs
msgid "At trakt.tv/oauth/applications create an app (any name, redirect urn:ietf:wg:oauth:2.0:oob) and copy its Client ID and Client Secret."
msgstr "Em trakt.tv/oauth/applications, crie um app (qualquer nome, redirect urn:ietf:wg:oauth:2.0:oob) e copie o Client ID e o Client Secret dele."

#: src/lib.rs
msgid "Client secret"
msgstr "Client Secret"

#: src/lib.rs
msgid "Up next row"
msgstr "Fileira A seguir"

#: src/lib.rs
msgid "The next episode of each show you are part-way through."
msgstr "O próximo episódio de cada série que você começou e ainda não terminou."

#: src/lib.rs
msgid "Watchlist row"
msgstr "Fileira Watchlist"

#: src/lib.rs
msgid "Open with the TV's own search"
msgstr "Abrir com a pesquisa da própria TV"

#: src/lib.rs
msgid "On, a title opens in the TV's own search, which on Google TV lists where it streams. Off, Lounge searches your apps and plugins for it."
msgstr "Sim: o título abre na pesquisa da própria TV, que no Google TV mostra onde ele está disponível. Não: o Lounge procura o título nos seus apps e plugins."

#: src/lib.rs
msgid "Could not renew the Trakt sign-in. It tries again on the next refresh."
msgstr "Não foi possível renovar o login do Trakt. Vai tentar de novo na próxima atualização."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client ID"
msgstr "Client ID"

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client secret"
msgstr "Client Secret"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "The sign-in was declined on trakt.tv. Press Refresh now for a new code."
msgstr "O login foi recusado em trakt.tv. Pressione Atualizar agora para receber um novo código."

#: src/lib.rs
msgid "Trakt does not know this Client ID. Check it against your app at trakt.tv/oauth/applications."
msgstr "O Trakt não reconhece este Client ID. Compare-o com o do seu app em trakt.tv/oauth/applications."
