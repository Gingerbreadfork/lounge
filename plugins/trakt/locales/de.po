# Lounge, trakt: de
#
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Trakt no longer accepts this sign-in; it is renewed on the next refresh, or press Refresh now."
msgstr "Trakt akzeptiert diese Anmeldung nicht mehr; sie wird beim nächsten Aktualisieren erneuert, oder du drückst „Jetzt aktualisieren“."

#: src/lib.rs
msgid "Trakt is asking for a pause between requests. It tries again on the next refresh."
msgstr "Trakt verlangt eine Pause zwischen den Anfragen. Das Plugin versucht es beim nächsten Aktualisieren erneut."

#: src/lib.rs
msgid "Continue watching, up next and your watchlist from Trakt, across every service."
msgstr "Weiterschauen, Als Nächstes und deine Watchlist von Trakt, über alle Dienste hinweg."

#: src/lib.rs
msgid "Up next on Trakt"
msgstr "Als Nächstes auf Trakt"

#: src/lib.rs
msgid "Watchlist on Trakt"
msgstr "Watchlist auf Trakt"

#: src/lib.rs
msgid "Client ID"
msgstr "Client-ID"

#: src/lib.rs
msgid "At trakt.tv/oauth/applications create an app (any name, redirect urn:ietf:wg:oauth:2.0:oob) and copy its Client ID and Client Secret."
msgstr "Erstelle auf trakt.tv/oauth/applications eine App (beliebiger Name, Redirect urn:ietf:wg:oauth:2.0:oob) und kopiere deren Client-ID und Client-Secret."

#: src/lib.rs
msgid "Client secret"
msgstr "Client-Secret"

#: src/lib.rs
msgid "Up next row"
msgstr "Reihe „Als Nächstes“"

#: src/lib.rs
msgid "The next episode of each show you are part-way through."
msgstr "Die nächste Folge jeder Serie, bei der du mittendrin bist."

#: src/lib.rs
msgid "Watchlist row"
msgstr "Reihe „Watchlist“"

#: src/lib.rs
msgid "Open with the TV's own search"
msgstr "Mit der Suche des Fernsehers öffnen"

#: src/lib.rs
msgid "On, a title opens in the TV's own search, which on Google TV lists where it streams. Off, Lounge searches your apps and plugins for it."
msgstr "An: Ein Titel öffnet sich in der Suche des Fernsehers, die auf Google TV zeigt, wo er gestreamt wird. Aus: Lounge sucht ihn in deinen Apps und Plugins."

#: src/lib.rs
msgid "Could not renew the Trakt sign-in. It tries again on the next refresh."
msgstr "Die Trakt-Anmeldung ließ sich nicht erneuern. Das Plugin versucht es beim nächsten Aktualisieren erneut."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client ID"
msgstr "Client-ID"

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client secret"
msgstr "Client-Secret"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "The sign-in was declined on trakt.tv. Press Refresh now for a new code."
msgstr "Die Anmeldung wurde auf trakt.tv abgelehnt. Drücke „Jetzt aktualisieren“ für einen neuen Code."

#: src/lib.rs
msgid "Trakt does not know this Client ID. Check it against your app at trakt.tv/oauth/applications."
msgstr "Trakt kennt diese Client-ID nicht. Vergleiche sie mit deiner App auf trakt.tv/oauth/applications."
