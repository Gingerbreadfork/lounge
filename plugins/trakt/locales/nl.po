# Lounge, trakt: nl
#
msgid ""
msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Trakt no longer accepts this sign-in; it is renewed on the next refresh, or press Refresh now."
msgstr "Je bent niet meer ingelogd bij Trakt; dat wordt bij de volgende vernieuwing hersteld, of druk op Nu vernieuwen."

#: src/lib.rs
msgid "Trakt is asking for a pause between requests. It tries again on the next refresh."
msgstr "Trakt vraagt om een pauze tussen verzoeken. Bij de volgende vernieuwing probeert de plug-in het opnieuw."

#: src/lib.rs
msgid "Continue watching, up next and your watchlist from Trakt, across every service."
msgstr "Verder kijken, hierna en je watchlist uit Trakt, van alle diensten."

#: src/lib.rs
msgid "Up next on Trakt"
msgstr "Hierna op Trakt"

#: src/lib.rs
msgid "Watchlist on Trakt"
msgstr "Watchlist op Trakt"

#: src/lib.rs
msgid "Client ID"
msgstr "Client-ID"

#: src/lib.rs
msgid "At trakt.tv/oauth/applications create an app (any name, redirect urn:ietf:wg:oauth:2.0:oob) and copy its Client ID and Client Secret."
msgstr "Maak op trakt.tv/oauth/applications een app (naam naar keuze, redirect urn:ietf:wg:oauth:2.0:oob) en kopieer de Client-ID en het Client secret."

#: src/lib.rs
msgid "Client secret"
msgstr "Client secret"

#: src/lib.rs
msgid "Up next row"
msgstr "Rij Hierna"

#: src/lib.rs
msgid "The next episode of each show you are part-way through."
msgstr "De volgende aflevering van elke serie waar je middenin zit."

#: src/lib.rs
msgid "Watchlist row"
msgstr "Rij Watchlist"

#: src/lib.rs
msgid "Open with the TV's own search"
msgstr "Openen met de zoekfunctie van de tv"

#: src/lib.rs
msgid "On, a title opens in the TV's own search, which on Google TV lists where it streams. Off, Lounge searches your apps and plugins for it."
msgstr "Aan: een titel opent in de zoekfunctie van de tv, die op Google TV laat zien waar je hem kunt streamen. Uit: Lounge zoekt de titel in je apps en plug-ins."

#: src/lib.rs
msgid "Could not renew the Trakt sign-in. It tries again on the next refresh."
msgstr "Het inloggen bij Trakt kon niet worden verlengd. Bij de volgende vernieuwing probeert de plug-in het opnieuw."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client ID"
msgstr "client-ID"

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client secret"
msgstr "client secret"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "The sign-in was declined on trakt.tv. Press Refresh now for a new code."
msgstr "Het inloggen is op trakt.tv geweigerd. Druk op Nu vernieuwen voor een nieuwe code."

#: src/lib.rs
msgid "Trakt does not know this Client ID. Check it against your app at trakt.tv/oauth/applications."
msgstr "Trakt kent deze Client-ID niet. Vergelijk hem met je app op trakt.tv/oauth/applications."
