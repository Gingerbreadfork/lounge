msgid ""
msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. On Deck is Plex's own name for what to watch next.
#: src/lib.rs
msgid "On Deck and recently added from your Plex Media Server."
msgstr "On Deck en onlangs toegevoegd van je Plex Media Server."

#: src/lib.rs
msgid "Recently added on Plex"
msgstr "Onlangs toegevoegd op Plex"

#: src/lib.rs
msgid "Server address"
msgstr "Serveradres"

#: src/lib.rs
msgid "Turn the plugin on and sign in with the code it shows, and this page says which address to enter. It looks like http://192.168.0.10:32400."
msgstr "Zet de plug-in aan en log in met de code die hij toont; deze pagina zegt dan welk adres je invult. Het ziet eruit als http://192.168.0.10:32400."

#: src/lib.rs
msgid "Plex token"
msgstr "Plex-token"

#. Get Info and View XML are names in Plex Web's menus.
#: src/lib.rs
msgid "Leave it empty to sign in with a code instead. To skip plex.tv, or to use an address of your own, paste one: in Plex Web open any item, then Get Info, then View XML, and copy the value after X-Plex-Token= at the end of the address."
msgstr "Laat dit leeg om met een code in te loggen. Wil je plex.tv overslaan of een eigen adres gebruiken, plak er dan een: open in Plex Web een willekeurig item, kies Get Info en dan View XML, en kopieer de waarde na X-Plex-Token= aan het eind van het adres."

#: src/lib.rs
msgid "Libraries for recently added"
msgstr "Bibliotheken voor onlangs toegevoegd"

#: src/lib.rs
msgid "Library names separated by commas. Empty means all of them."
msgstr "Namen van bibliotheken, gescheiden door komma's. Leeg betekent allemaal."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "serveradres"

#: src/lib.rs
msgid "Your server is at {address}"
msgstr "Je server staat op {address}"

#. {server} is the name a Plex server was given, such as Den.
#: src/lib.rs
msgid "{server} is at {address}"
msgstr "{server} staat op {address}"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Signed in to Plex, but this account has no server. Sign the server in to the same account, then press Refresh now."
msgstr "Ingelogd bij Plex, maar dit account heeft geen server. Log de server in bij hetzelfde account en druk dan op Nu vernieuwen."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Signed in to Plex. Now enter your server's address in the plugin's settings: {servers}."
msgstr "Ingelogd bij Plex. Zet nu het adres van je server in de instellingen van de plug-in: {servers}."

#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one."
msgstr "Plex kent geen server van jou op {address}. Controleer het serveradres in de instellingen van de plug-in, of plak een Plex-token om deze toch te gebruiken."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one. {servers}."
msgstr "Plex kent geen server van jou op {address}. Controleer het serveradres in de instellingen van de plug-in, of plak een Plex-token om deze toch te gebruiken. {servers}."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Plex rejected the sign-in at this server. Press Refresh now to check it again."
msgstr "Plex heeft het inloggen bij deze server geweigerd. Druk op Nu vernieuwen om het opnieuw te controleren."

#: src/lib.rs
msgid "Plex rejected the token. Copy a fresh X-Plex-Token from Plex Web."
msgstr "Plex heeft het token geweigerd. Kopieer een nieuw X-Plex-Token uit Plex Web."
