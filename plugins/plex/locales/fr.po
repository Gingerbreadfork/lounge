msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. On Deck is Plex's own name for what to watch next.
#: src/lib.rs
msgid "On Deck and recently added from your Plex Media Server."
msgstr "« On Deck » et les ajouts récents de votre Plex Media Server."

#: src/lib.rs
msgid "Recently added on Plex"
msgstr "Ajouts récents sur Plex"

#: src/lib.rs
msgid "Server address"
msgstr "Adresse du serveur"

#: src/lib.rs
msgid "Turn the plugin on and sign in with the code it shows, and this page says which address to enter. It looks like http://192.168.0.10:32400."
msgstr "Activez le plugin et connectez-vous avec le code qu’il affiche : cette page indique alors l’adresse à saisir. Elle ressemble à http://192.168.0.10:32400."

#: src/lib.rs
msgid "Plex token"
msgstr "Jeton Plex"

#. Get Info and View XML are names in Plex Web's menus.
#: src/lib.rs
msgid "Leave it empty to sign in with a code instead. To skip plex.tv, or to use an address of your own, paste one: in Plex Web open any item, then Get Info, then View XML, and copy the value after X-Plex-Token= at the end of the address."
msgstr "Laissez vide pour vous connecter plutôt avec un code. Pour vous passer de plex.tv, ou pour utiliser votre propre adresse, collez-en un : dans Plex Web, ouvrez un élément, puis Get Info, puis View XML, et copiez la valeur qui suit X-Plex-Token= à la fin de l’adresse."

#: src/lib.rs
msgid "Libraries for recently added"
msgstr "Bibliothèques pour les ajouts récents"

#: src/lib.rs
msgid "Library names separated by commas. Empty means all of them."
msgstr "Des noms de bibliothèques séparés par des virgules. Vide, toutes sont incluses."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "adresse du serveur"

#: src/lib.rs
msgid "Your server is at {address}"
msgstr "Votre serveur est à l’adresse {address}"

#. {server} is the name a Plex server was given, such as Den.
#: src/lib.rs
msgid "{server} is at {address}"
msgstr "{server} est à l’adresse {address}"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Signed in to Plex, but this account has no server. Sign the server in to the same account, then press Refresh now."
msgstr "La connexion à Plex est faite, mais ce compte n’a aucun serveur. Connectez le serveur au même compte, puis appuyez sur « Actualiser maintenant »."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Signed in to Plex. Now enter your server's address in the plugin's settings: {servers}."
msgstr "La connexion à Plex est faite. Saisissez maintenant l’adresse de votre serveur dans les paramètres du plugin : {servers}."

#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one."
msgstr "Plex ne vous connaît aucun serveur à l’adresse {address}. Vérifiez l’adresse du serveur dans les paramètres du plugin, ou collez un jeton Plex pour utiliser celle-ci."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one. {servers}."
msgstr "Plex ne vous connaît aucun serveur à l’adresse {address}. Vérifiez l’adresse du serveur dans les paramètres du plugin, ou collez un jeton Plex pour utiliser celle-ci. {servers}."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Plex rejected the sign-in at this server. Press Refresh now to check it again."
msgstr "Plex a refusé la connexion à ce serveur. Appuyez sur « Actualiser maintenant » pour la vérifier à nouveau."

#: src/lib.rs
msgid "Plex rejected the token. Copy a fresh X-Plex-Token from Plex Web."
msgstr "Plex a refusé le jeton. Copiez un nouveau X-Plex-Token depuis Plex Web."
