# Lounge, plex: de
#
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. On Deck is Plex's own name for what to watch next.
#: src/lib.rs
msgid "On Deck and recently added from your Plex Media Server."
msgstr "On Deck und kürzlich Hinzugefügtes von deinem Plex Media Server."

#: src/lib.rs
msgid "Recently added on Plex"
msgstr "Kürzlich hinzugefügt auf Plex"

#: src/lib.rs
msgid "Server address"
msgstr "Serveradresse"

#: src/lib.rs
msgid "Turn the plugin on and sign in with the code it shows, and this page says which address to enter. It looks like http://192.168.0.10:32400."
msgstr "Schalte das Plugin ein und melde dich mit dem angezeigten Code an; danach nennt dir diese Seite die Adresse. Sie sieht etwa so aus: http://192.168.0.10:32400."

#: src/lib.rs
msgid "Plex token"
msgstr "Plex-Token"

#. Get Info and View XML are names in Plex Web's menus.
#: src/lib.rs
msgid "Leave it empty to sign in with a code instead. To skip plex.tv, or to use an address of your own, paste one: in Plex Web open any item, then Get Info, then View XML, and copy the value after X-Plex-Token= at the end of the address."
msgstr "Lass das Feld leer, um dich stattdessen mit einem Code anzumelden. Willst du plex.tv umgehen oder eine eigene Adresse verwenden, füge ein Token ein: Öffne in Plex Web einen beliebigen Eintrag, dann „Get Info“, dann „View XML“, und kopiere den Wert hinter X-Plex-Token= am Ende der Adresse."

#: src/lib.rs
msgid "Libraries for recently added"
msgstr "Bibliotheken für „Kürzlich hinzugefügt“"

#: src/lib.rs
msgid "Library names separated by commas. Empty means all of them."
msgstr "Namen der Bibliotheken, durch Kommas getrennt. Leer heißt: alle."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "Serveradresse"

#: src/lib.rs
msgid "Your server is at {address}"
msgstr "Dein Server ist unter {address} erreichbar"

#. {server} is the name a Plex server was given, such as Den.
#: src/lib.rs
msgid "{server} is at {address}"
msgstr "{server} ist unter {address} erreichbar"

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Signed in to Plex, but this account has no server. Sign the server in to the same account, then press Refresh now."
msgstr "Bei Plex angemeldet, aber dieses Konto hat keinen Server. Melde den Server beim selben Konto an und drücke dann „Jetzt aktualisieren“."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Signed in to Plex. Now enter your server's address in the plugin's settings: {servers}."
msgstr "Bei Plex angemeldet. Trage jetzt die Adresse deines Servers in den Plugin-Einstellungen ein: {servers}."

#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one."
msgstr "Plex kennt unter {address} keinen deiner Server. Prüfe die Serveradresse in den Plugin-Einstellungen oder füge ein Plex-Token ein, um diese Adresse zu verwenden."

#. {servers} lists servers and where they are, such as "Den is at http://192.168.0.10:32400, Cabin is at https://cabin.example:32400".
#: src/lib.rs
msgid "Plex knows no server of yours at {address}. Check the server address in the plugin's settings, or paste a Plex token to use this one. {servers}."
msgstr "Plex kennt unter {address} keinen deiner Server. Prüfe die Serveradresse in den Plugin-Einstellungen oder füge ein Plex-Token ein, um diese Adresse zu verwenden. {servers}."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Plex rejected the sign-in at this server. Press Refresh now to check it again."
msgstr "Plex hat die Anmeldung an diesem Server abgelehnt. Drücke „Jetzt aktualisieren“, um sie erneut zu prüfen."

#: src/lib.rs
msgid "Plex rejected the token. Copy a fresh X-Plex-Token from Plex Web."
msgstr "Plex hat das Token abgelehnt. Kopiere ein frisches X-Plex-Token aus Plex Web."
