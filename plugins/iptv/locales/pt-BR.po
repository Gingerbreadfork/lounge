msgid ""
msgstr ""
"Language: pt-BR\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#: src/lib.rs
msgid "IPTV playlist"
msgstr "Lista de IPTV"

#: src/lib.rs
msgid "Channels from an M3U playlist, with programme information from an XMLTV guide."
msgstr "Canais de uma lista M3U, com as informações dos programas vindas de um guia XMLTV."

#: src/lib.rs
msgid "Playlist address (M3U)"
msgstr "Endereço da lista (M3U)"

#: src/lib.rs
msgid "The .m3u or .m3u8 playlist your provider gave you."
msgstr "A lista .m3u ou .m3u8 que o seu provedor forneceu."

#: src/lib.rs
msgid "Guide address (XMLTV)"
msgstr "Endereço do guia (XMLTV)"

#: src/lib.rs
msgid "Leave it empty to use the guide the playlist names, or an Xtream provider's own. Plain or .gz XMLTV both work."
msgstr "Deixe em branco para usar o guia que a lista indica ou o do próprio provedor Xtream. XMLTV simples ou .gz, os dois funcionam."

#: src/lib.rs
msgid "Only this group"
msgstr "Só este grupo"

#: src/lib.rs
msgid "Shows only the channels in this group, for very large playlists."
msgstr "Mostra só os canais deste grupo, para listas muito grandes."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "playlist address"
msgstr "endereço da lista"

#: src/lib.rs
msgid "The playlist has no channels in the group \"{group}\". Check the group's name in the plugin's settings."
msgstr "A lista não tem canais no grupo \"{group}\". Verifique o nome do grupo nas configurações do plugin."

#: src/lib.rs
msgid "The playlist has no channels. Check the playlist address in the plugin's settings."
msgstr "A lista não tem canais. Verifique o endereço da lista nas configurações do plugin."

#: src/lib.rs
msgid "The playlist is larger than the 8 MB a plugin may read. Ask your provider for a smaller one, such as live channels only."
msgstr "A lista é maior do que os 8 MB que um plugin pode ler. Peça ao seu provedor uma lista menor, por exemplo, só com os canais ao vivo."

#: src/lib.rs
msgid "The playlist server at {host} answered with error {status}. Check the playlist address, then try again."
msgstr "O servidor da lista em {host} respondeu com o erro {status}. Verifique o endereço da lista e tente novamente."

#: src/lib.rs
msgid "The playlist server didn't answer at {host}. Check the playlist address, then try again."
msgstr "O servidor da lista não respondeu em {host}. Verifique o endereço da lista e tente novamente."

#. the name shown for a playlist channel that has none. {number} is its place in the playlist.
#: src/lib.rs
msgid "Channel {number}"
msgstr "Canal {number}"
