# Lounge, stremio: it
#
msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Stremio rejected the email or password. Check them in the plugin's settings."
msgstr "Stremio ha rifiutato l'email o la password. Controllale nelle impostazioni del plugin."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Stremio no longer knows this sign-in. Press Refresh now to sign in again."
msgstr "Stremio non riconosce più questo accesso. Premi Aggiorna ora per accedere di nuovo."

#: src/lib.rs
msgid "Continue watching, new episodes and your library from your Stremio account, opened in Stremio."
msgstr "Continua a guardare, nuovi episodi e la tua libreria dal tuo account Stremio, aperti in Stremio."

#: src/lib.rs
msgid "Library on Stremio"
msgstr "Libreria su Stremio"

#: src/lib.rs
msgid "Email"
msgstr "Email"

#. "both" are the email and the password, the two settings this sits between.
#: src/lib.rs
msgid "Leave both empty to sign in with a code on your phone instead; this page shows the code. Accounts made with Facebook or Apple have no password, so they sign in that way."
msgstr "Lasciale entrambe vuote per accedere invece con un codice dal telefono; questa pagina mostra il codice. Gli account creati con Facebook o Apple non hanno una password, quindi accedono in quel modo."

#: src/lib.rs
msgid "Password"
msgstr "Password"

#: src/lib.rs
msgid "Only with an email above."
msgstr "Solo se sopra c'è un'email."

#: src/lib.rs
msgid "New episodes"
msgstr "Nuovi episodi"

#. "Continue watching" is the row on Lounge's home screen.
#: src/lib.rs
msgid "A show in your library with an episode out since you last watched it joins Continue watching as up next."
msgstr "Una serie della tua libreria con un episodio uscito dopo l'ultima volta che l'hai guardata compare in Continua a guardare come episodio a seguire."

#: src/lib.rs
msgid "Library row"
msgstr "Riga Libreria"

#: src/lib.rs
msgid "The movies and shows in your Stremio library, most recently watched first."
msgstr "I film e le serie della tua libreria di Stremio, a partire dagli ultimi guardati."

#: src/lib.rs
msgid "Add the password in the plugin's settings. To sign in with a code instead, leave the email empty too."
msgstr "Aggiungi la password nelle impostazioni del plugin. Per accedere invece con un codice, lascia vuota anche l'email."

#. {code} ends the web address. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Sign in: on your phone open link.stremio.com/{code} and sign in to Stremio, then press Refresh now here."
msgstr "Accedi: sul telefono apri link.stremio.com/{code} e accedi a Stremio, poi premi Aggiorna ora qui."

#. the step to take once link.stremio.com is open on the phone.
#: src/lib.rs
msgid "Sign in to Stremio on that page."
msgstr "Accedi a Stremio in quella pagina."
