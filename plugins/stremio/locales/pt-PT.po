# Lounge, stremio: pt-PT
#
msgid ""
msgstr ""
"Language: pt-PT\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Stremio rejected the email or password. Check them in the plugin's settings."
msgstr "O Stremio rejeitou o email ou a palavra-passe. Verifique-os nas definições do plugin."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Stremio no longer knows this sign-in. Press Refresh now to sign in again."
msgstr "O Stremio já não reconhece este início de sessão. Prima Atualizar agora para iniciar sessão novamente."

#: src/lib.rs
msgid "Continue watching, new episodes and your library from your Stremio account, opened in Stremio."
msgstr "Continuar a ver, novos episódios e a sua biblioteca, a partir da sua conta Stremio, abertos no Stremio."

#: src/lib.rs
msgid "Library on Stremio"
msgstr "Biblioteca no Stremio"

#: src/lib.rs
msgid "Email"
msgstr "Email"

#. "both" are the email and the password, the two settings this sits between.
#: src/lib.rs
msgid "Leave both empty to sign in with a code on your phone instead; this page shows the code. Accounts made with Facebook or Apple have no password, so they sign in that way."
msgstr "Deixe ambos vazios para iniciar sessão com um código no telemóvel; esta página mostra o código. As contas criadas com o Facebook ou a Apple não têm palavra-passe, por isso iniciam sessão dessa forma."

#: src/lib.rs
msgid "Password"
msgstr "Palavra-passe"

#: src/lib.rs
msgid "Only with an email above."
msgstr "Só com um email acima."

#: src/lib.rs
msgid "New episodes"
msgstr "Novos episódios"

#. "Continue watching" is the row on Lounge's home screen.
#: src/lib.rs
msgid "A show in your library with an episode out since you last watched it joins Continue watching as up next."
msgstr "Uma série da sua biblioteca com um episódio lançado desde a última vez que a viu entra em Continuar a ver como a seguir."

#: src/lib.rs
msgid "Library row"
msgstr "Linha da biblioteca"

#: src/lib.rs
msgid "The movies and shows in your Stremio library, most recently watched first."
msgstr "Os filmes e as séries da sua biblioteca do Stremio, primeiro os vistos mais recentemente."

#: src/lib.rs
msgid "Add the password in the plugin's settings. To sign in with a code instead, leave the email empty too."
msgstr "Adicione a palavra-passe nas definições do plugin. Para iniciar sessão com um código, deixe também o email vazio."

#. {code} ends the web address. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Sign in: on your phone open link.stremio.com/{code} and sign in to Stremio, then press Refresh now here."
msgstr "Iniciar sessão: no telemóvel, abra link.stremio.com/{code} e inicie sessão no Stremio; depois, prima Atualizar agora aqui."

#. the step to take once link.stremio.com is open on the phone.
#: src/lib.rs
msgid "Sign in to Stremio on that page."
msgstr "Inicie sessão no Stremio nessa página."
