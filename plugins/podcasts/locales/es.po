# Lounge, podcasts: es
#
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "This tile is out of date. Refresh the plugin, then try again."
msgstr "Esta tarjeta está desactualizada. Actualiza el plugin y vuelve a intentarlo."

#: src/lib.rs
msgid "Podcasts"
msgstr "Podcasts"

#: src/lib.rs
msgid "New episodes of the podcasts you follow, from their feeds, played in a player app such as VLC."
msgstr "Episodios nuevos de los podcasts que sigues, desde sus feeds, en una app de reproducción como VLC."

#: src/lib.rs
msgid "New podcast episodes"
msgstr "Episodios nuevos de podcasts"

#: src/lib.rs
msgid "Your podcasts"
msgstr "Tus podcasts"

#: src/lib.rs
msgid "Podcasts you follow"
msgstr "Podcasts que sigues"

#: src/lib.rs
msgid "Feed links, Apple Podcasts links or a link to an OPML export, one per line or separated by commas. An OPML file from another podcast app can be pasted in whole. Lounge's search finds podcasts too, and plays their latest episode."
msgstr "Enlaces de feeds, enlaces de Apple Podcasts o un enlace a una exportación OPML, uno por línea o separados por comas. Un archivo OPML de otra app de podcasts se puede pegar entero. La búsqueda de Lounge también encuentra podcasts y reproduce su último episodio."

#: src/lib.rs
msgid "Episodes per podcast"
msgstr "Episodios por podcast"

#: src/lib.rs
msgid "From 1 to 10."
msgstr "De 1 a 10."

#. the label of a field that takes a number, which stands where the … is.
#: src/lib.rs
msgid "Only the last … days"
msgstr "Solo los últimos … días"

#: src/lib.rs
msgid "0 shows each feed's newest episodes whatever their age."
msgstr "Con 0 se muestran los episodios más recientes de cada feed, sin importar su antigüedad."

#: src/lib.rs
msgid "Your podcasts row"
msgstr "Fila Tus podcasts"

#: src/lib.rs
msgid "A tile per podcast that plays its latest episode."
msgstr "Una tarjeta por podcast, que reproduce su último episodio."

#: src/lib.rs
msgid "Country for search"
msgstr "País para la búsqueda"

#: src/lib.rs
msgid "Two letters, like au or gb, so search finds the podcasts of your country first. Left empty, it follows your Apple links."
msgstr "Dos letras, como au o gb, para que la búsqueda encuentre primero los podcasts de tu país. Si lo dejas vacío, se guía por tus enlaces de Apple."

#: src/lib.rs
msgid "No podcasts yet. Add a feed link, an Apple Podcasts link or an OPML export in the plugin's settings."
msgstr "Todavía no hay podcasts. Añade un enlace de feed, un enlace de Apple Podcasts o una exportación OPML en los ajustes del plugin."

#: src/lib.rs
msgid "There is no feed at {address} any more."
msgstr "Ya no hay ningún feed en {address}."

#: src/lib.rs
msgid "This podcast has no episodes to play yet."
msgstr "Este podcast aún no tiene episodios que reproducir."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} has no episodes to play yet."
msgstr "{title} aún no tiene episodios que reproducir."

#: src/lib.rs
msgid "The feed at {address} is too big to read, even in part. Only its newest episodes are needed; the publisher's other links may give a smaller feed."
msgstr "El feed de {address} es demasiado grande para leerlo, ni siquiera en parte. Solo hacen falta sus episodios más recientes; puede que otros enlaces del editor den un feed más pequeño."

#: src/lib.rs
msgid "The feed at {address} didn't answer. Check the link in the plugin's settings and the TV's connection."
msgstr "El feed de {address} no respondió. Comprueba el enlace en los ajustes del plugin y la conexión de la TV."

#: src/lib.rs
msgid "There is no feed at {address} any more. Check the link in the plugin's settings."
msgstr "Ya no hay ningún feed en {address}. Comprueba el enlace en los ajustes del plugin."

#: src/lib.rs
msgid "The feed at {address} answered with error {status}. Try again later."
msgstr "El feed de {address} respondió con el error {status}. Vuelve a intentarlo más tarde."

#. {piece} is a link typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is an Apple link without a podcast id. Open the podcast's own page and copy that link."
msgstr "«{piece}» es un enlace de Apple sin ID de podcast. Abre la página del podcast y copia ese enlace."

#. {piece} is a link typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is not a link Lounge can fetch. Check the podcasts in the plugin's settings."
msgstr "«{piece}» no es un enlace que Lounge pueda abrir. Comprueba los podcasts en los ajustes del plugin."

#. {piece} is what was typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is not a feed link or an Apple Podcasts link. Check the podcasts in the plugin's settings."
msgstr "«{piece}» no es un enlace de feed ni de Apple Podcasts. Comprueba los podcasts en los ajustes del plugin."

#: src/lib.rs
msgid "A podcast you listed is only on Apple Podcasts, with no feed to read."
msgstr "Uno de tus podcasts solo está en Apple Podcasts, sin un feed que leer."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} is only on Apple Podcasts, with no feed to read."
msgstr "{title} solo está en Apple Podcasts, sin un feed que leer."

#: src/lib.rs
msgid "Apple has no podcast with the id {id}. Check the link in the plugin's settings."
msgstr "Apple no tiene ningún podcast con el ID {id}. Comprueba el enlace en los ajustes del plugin."

#: src/lib.rs
msgid "The list at {address} holds no podcast feeds. Check the link in the plugin's settings."
msgstr "La lista de {address} no contiene feeds de podcasts. Comprueba el enlace en los ajustes del plugin."

#: src/lib.rs
msgid "The link {address} is not a podcast feed. Check it in the plugin's settings."
msgstr "El enlace {address} no es un feed de podcast. Compruébalo en los ajustes del plugin."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} has no episodes with a file to play."
msgstr "{title} no tiene episodios con un archivo que reproducir."

#: src/lib.rs
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/lib.rs
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#. a length of time. {hours} is a count of hours, such as "2 hours", and {minutes} a count of minutes, such as "25 minutes".
#: src/lib.rs
msgid "{hours} {minutes}"
msgstr "{hours} y {minutes}"

#. {show} is a podcast's name and {length} how long the episode runs, such as "48 minutes".
#: src/lib.rs
msgid "{show}, {length}"
msgstr "{show}, {length}"

#. {title} is the title of a podcast's newest episode.
#: src/lib.rs
msgid "Latest: {title}"
msgstr "Lo último: {title}"
