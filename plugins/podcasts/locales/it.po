# Lounge, podcasts: it
#
msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "This tile is out of date. Refresh the plugin, then try again."
msgstr "Questo riquadro non è più aggiornato. Aggiorna il plugin, poi riprova."

#: src/lib.rs
msgid "Podcasts"
msgstr "Podcast"

#: src/lib.rs
msgid "New episodes of the podcasts you follow, from their feeds, played in a player app such as VLC."
msgstr "I nuovi episodi dei podcast che segui, presi dai loro feed e riprodotti in un'app come VLC."

#: src/lib.rs
msgid "New podcast episodes"
msgstr "Nuovi episodi dei podcast"

#: src/lib.rs
msgid "Your podcasts"
msgstr "I tuoi podcast"

#: src/lib.rs
msgid "Podcasts you follow"
msgstr "Podcast che segui"

#: src/lib.rs
msgid "Feed links, Apple Podcasts links or a link to an OPML export, one per line or separated by commas. An OPML file from another podcast app can be pasted in whole. Lounge's search finds podcasts too, and plays their latest episode."
msgstr "Link ai feed, link di Apple Podcasts o il link a un'esportazione OPML, uno per riga o separati da virgole. Puoi anche incollare per intero un file OPML esportato da un'altra app di podcast. Anche la ricerca di Lounge trova i podcast e ne riproduce l'ultimo episodio."

#: src/lib.rs
msgid "Episodes per podcast"
msgstr "Episodi per podcast"

#: src/lib.rs
msgid "From 1 to 10."
msgstr "Da 1 a 10."

#. the label of a field that takes a number, which stands where the … is.
#: src/lib.rs
msgid "Only the last … days"
msgstr "Solo gli ultimi … giorni"

#: src/lib.rs
msgid "0 shows each feed's newest episodes whatever their age."
msgstr "Con 0 vedi gli episodi più recenti di ogni feed, di qualunque data."

#: src/lib.rs
msgid "Your podcasts row"
msgstr "Riga I tuoi podcast"

#: src/lib.rs
msgid "A tile per podcast that plays its latest episode."
msgstr "Un riquadro per ogni podcast, che ne riproduce l'ultimo episodio."

#: src/lib.rs
msgid "Country for search"
msgstr "Paese per la ricerca"

#: src/lib.rs
msgid "Two letters, like au or gb, so search finds the podcasts of your country first. Left empty, it follows your Apple links."
msgstr "Due lettere, ad esempio au o gb, così la ricerca trova prima i podcast del tuo paese. Se è vuoto, segue i tuoi link Apple."

#: src/lib.rs
msgid "No podcasts yet. Add a feed link, an Apple Podcasts link or an OPML export in the plugin's settings."
msgstr "Ancora nessun podcast. Aggiungi il link a un feed, un link di Apple Podcasts o un'esportazione OPML nelle impostazioni del plugin."

#: src/lib.rs
msgid "There is no feed at {address} any more."
msgstr "Non c'è più nessun feed all'indirizzo {address}."

#: src/lib.rs
msgid "This podcast has no episodes to play yet."
msgstr "Questo podcast non ha ancora episodi da riprodurre."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} has no episodes to play yet."
msgstr "{title} non ha ancora episodi da riprodurre."

#: src/lib.rs
msgid "The feed at {address} is too big to read, even in part. Only its newest episodes are needed; the publisher's other links may give a smaller feed."
msgstr "Il feed all'indirizzo {address} è troppo grande da leggere, anche solo in parte. Servono solo gli episodi più recenti; tra gli altri link dell'editore potrebbe esserci un feed più piccolo."

#: src/lib.rs
msgid "The feed at {address} didn't answer. Check the link in the plugin's settings and the TV's connection."
msgstr "Il feed all'indirizzo {address} non ha risposto. Controlla il link nelle impostazioni del plugin e la connessione della TV."

#: src/lib.rs
msgid "There is no feed at {address} any more. Check the link in the plugin's settings."
msgstr "Non c'è più nessun feed all'indirizzo {address}. Controlla il link nelle impostazioni del plugin."

#: src/lib.rs
msgid "The feed at {address} answered with error {status}. Try again later."
msgstr "Il feed all'indirizzo {address} ha risposto con l'errore {status}. Riprova più tardi."

#. {piece} is a link typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is an Apple link without a podcast id. Open the podcast's own page and copy that link."
msgstr "\"{piece}\" è un link Apple senza l'ID di un podcast. Apri la pagina del podcast e copia quel link."

#. {piece} is a link typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is not a link Lounge can fetch. Check the podcasts in the plugin's settings."
msgstr "\"{piece}\" non è un link che Lounge può aprire. Controlla i podcast nelle impostazioni del plugin."

#. {piece} is what was typed into the plugin's settings.
#: src/lib.rs
msgid "\"{piece}\" is not a feed link or an Apple Podcasts link. Check the podcasts in the plugin's settings."
msgstr "\"{piece}\" non è il link di un feed né un link di Apple Podcasts. Controlla i podcast nelle impostazioni del plugin."

#: src/lib.rs
msgid "A podcast you listed is only on Apple Podcasts, with no feed to read."
msgstr "Uno dei podcast che hai indicato è solo su Apple Podcasts, senza un feed da leggere."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} is only on Apple Podcasts, with no feed to read."
msgstr "{title} è solo su Apple Podcasts, senza un feed da leggere."

#: src/lib.rs
msgid "Apple has no podcast with the id {id}. Check the link in the plugin's settings."
msgstr "Apple non ha nessun podcast con l'ID {id}. Controlla il link nelle impostazioni del plugin."

#: src/lib.rs
msgid "The list at {address} holds no podcast feeds. Check the link in the plugin's settings."
msgstr "L'elenco all'indirizzo {address} non contiene feed di podcast. Controlla il link nelle impostazioni del plugin."

#: src/lib.rs
msgid "The link {address} is not a podcast feed. Check it in the plugin's settings."
msgstr "Il link {address} non è il feed di un podcast. Controllalo nelle impostazioni del plugin."

#. {title} is a podcast's name.
#: src/lib.rs
msgid "{title} has no episodes with a file to play."
msgstr "{title} non ha episodi con un file da riprodurre."

#: src/lib.rs
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} ora"
msgstr[1] "{n} ore"

#: src/lib.rs
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minuti"

#. a length of time. {hours} is a count of hours, such as "2 hours", and {minutes} a count of minutes, such as "25 minutes".
#: src/lib.rs
msgid "{hours} {minutes}"
msgstr "{hours} e {minutes}"

#. {show} is a podcast's name and {length} how long the episode runs, such as "48 minutes".
#: src/lib.rs
msgid "{show}, {length}"
msgstr "{show}, {length}"

#. {title} is the title of a podcast's newest episode.
#: src/lib.rs
msgid "Latest: {title}"
msgstr "Ultimo: {title}"
