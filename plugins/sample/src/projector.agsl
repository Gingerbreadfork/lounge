// Projector: smoke turning in the beam of a projector at the back of a small cinema.
uniform float2 resolution;
uniform float time;
uniform float drift;
layout(color) uniform half4 velvet;
layout(color) uniform half4 beam;

float hash(float2 p) {
    float3 p3 = fract(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
               mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);
}

float fbm(float2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = float2(1.6 * p.x + 1.2 * p.y, -1.2 * p.x + 1.6 * p.y) + float2(17.0, 7.0);
        a *= 0.5;
    }
    return v;
}

half4 main(float2 coord) {
    float2 p = (coord - 0.5 * resolution) / resolution.y;
    float t = time * drift;

    // The lens sits high on the right and throws a widening cone down to the left.
    float2 d = p - float2(0.95, -0.42);
    float2 axis = normalize(float2(-1.0, 0.42));
    float along = dot(d, axis);
    float across = abs(d.x * axis.y - d.y * axis.x);
    float width = 0.02 + along * 0.3;
    float cone = smoothstep(width, width * 0.4, across) * smoothstep(0.0, 0.05, along);
    float fade = exp(-along * 0.7);

    float2 s = p * 2.4 + float2(t * 0.25, t * 0.6);
    float2 w = float2(fbm(s + float2(0.0, t * 0.2)), fbm(s + float2(5.2, 1.3)));
    float smoke = smoothstep(0.3, 0.85, fbm(s + 1.8 * w));
    float flicker = 0.93 + 0.07 * noise(float2(time * 7.0, 0.0));

    // Dust drifting up through the light, one mote to a few cells.
    float2 g = p * 38.0 + float2(0.0, time * 0.35);
    float2 cell = floor(g);
    float2 o = float2(hash(cell + 3.1), hash(cell + 7.7)) - 0.5;
    float mote = step(0.93, hash(cell)) * smoothstep(0.12, 0.0, length(fract(g) - 0.5 - o * 0.6));
    mote *= 0.6 + 0.4 * sin(time * 2.0 + hash(cell) * 30.0);

    float light = cone * fade * ((0.18 + 0.82 * smoke) * flicker + 0.5 * mote);
    half3 col = velvet.rgb * 0.7 + beam.rgb * half(light * 0.9);
    col += beam.rgb * half(0.5 * exp(-length(d) * 22.0));
    return half4(col, 1.0);
}
