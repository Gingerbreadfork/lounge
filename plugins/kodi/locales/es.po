# Lounge, kodi: es
#
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Kodi turned down the plugin's request. Check that Kodi is up to date, then try again."
msgstr "Kodi rechazó la solicitud del plugin. Comprueba que Kodi esté actualizado y vuelve a intentarlo."

#: src/lib.rs
msgid "This tile is out of date. Refresh the plugin, then try again."
msgstr "Esta tarjeta está desactualizada. Actualiza el plugin y vuelve a intentarlo."

#: src/lib.rs
msgid "Continue watching, up next, recently added and Live TV from your Kodi library; Kodi plays them."
msgstr "Seguir viendo, a continuación, lo añadido recientemente y la TV en directo de tu biblioteca de Kodi; los reproduce Kodi."

#: src/lib.rs
msgid "Up next on Kodi"
msgstr "A continuación en Kodi"

#: src/lib.rs
msgid "New on Kodi"
msgstr "Novedades en Kodi"

#: src/lib.rs
msgid "Kodi address"
msgstr "Dirección de Kodi"

#. Settings, Services, Control and Allow remote control via HTTP are names in Kodi's own menus.
#: src/lib.rs
msgid "Like http://192.168.0.20:8080, or http://localhost:8080 for Kodi on this TV. In Kodi's Settings, Services, Control, turn on Allow remote control via HTTP."
msgstr "Por ejemplo, http://192.168.0.20:8080, o http://localhost:8080 para Kodi en esta TV. En Kodi, en Ajustes, Servicios, Control, activa Permitir control remoto vía HTTP."

#. a setting and its help. The second kodi is the username itself, kept as it is.
#: src/lib.rs
msgid "Username"
msgstr "Nombre de usuario"

#. a setting and its help. The second kodi is the username itself, kept as it is.
#: src/lib.rs
msgid "Kodi's default is kodi."
msgstr "El predeterminado de Kodi es kodi."

#: src/lib.rs
msgid "Password"
msgstr "Contraseña"

#: src/lib.rs
msgid "Kodi app"
msgstr "App de Kodi"

#: src/lib.rs
msgid "The package brought to the front after Kodi starts playing."
msgstr "El paquete que pasa a primer plano cuando Kodi empieza a reproducir."

#: src/lib.rs
msgid "Bring Kodi to the front"
msgstr "Pasar Kodi a primer plano"

#: src/lib.rs
msgid "On when Kodi runs on this TV. Off when it is another box: it starts playing and this TV stays where it is."
msgstr "Sí: Kodi está en esta TV. No: está en otro aparato; empieza a reproducir y esta TV se queda como está."

#: src/lib.rs
msgid "Live TV channels"
msgstr "Canales de TV en directo"

#: src/lib.rs
msgid "Kodi's PVR channels in Live now and the guide."
msgstr "Los canales PVR de Kodi, en la fila En directo ahora y en la guía."

#: src/lib.rs
msgid "Kodi has no episodes of this show. Update Kodi's library, then try again."
msgstr "Kodi no tiene episodios de esta serie. Actualiza la biblioteca de Kodi y vuelve a intentarlo."

#: src/lib.rs
msgid "Kodi would not play it. Refresh the plugin, then try again."
msgstr "Kodi se negó a reproducirlo. Actualiza el plugin y vuelve a intentarlo."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgctxt "in a sentence"
msgid "Kodi address"
msgstr "dirección de Kodi"

#. {address} is the address in the settings and {local} the one to use, such as http://localhost:8080.
#: src/lib.rs
msgid "The address {address} is this TV's own, which a plugin may not use. For Kodi on this TV, set the address to {local}."
msgstr "La dirección {address} es la de esta misma TV, y un plugin no puede usarla. Para Kodi en esta TV, pon como dirección {local}."

#: src/lib.rs
msgid "Kodi didn't answer at {address}. Check that it is running and allows remote control over HTTP, then try again."
msgstr "Kodi no respondió en {address}. Comprueba que esté en marcha y que permita el control remoto por HTTP, y vuelve a intentarlo."

#: src/lib.rs
msgid "Kodi refused the username or password. Check them in the plugin's settings."
msgstr "Kodi rechazó el nombre de usuario o la contraseña. Compruébalos en los ajustes del plugin."
