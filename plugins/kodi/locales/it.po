# Lounge, kodi: it
#
msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Kodi turned down the plugin's request. Check that Kodi is up to date, then try again."
msgstr "Kodi ha rifiutato la richiesta del plugin. Controlla che Kodi sia aggiornato, poi riprova."

#: src/lib.rs
msgid "This tile is out of date. Refresh the plugin, then try again."
msgstr "Questo riquadro non è più aggiornato. Aggiorna il plugin, poi riprova."

#: src/lib.rs
msgid "Continue watching, up next, recently added and Live TV from your Kodi library; Kodi plays them."
msgstr "Continua a guardare, a seguire, aggiunti di recente e TV in diretta dalla tua libreria di Kodi; a riprodurli è Kodi."

#: src/lib.rs
msgid "Up next on Kodi"
msgstr "A seguire su Kodi"

#: src/lib.rs
msgid "New on Kodi"
msgstr "Novità su Kodi"

#: src/lib.rs
msgid "Kodi address"
msgstr "Indirizzo di Kodi"

#. Settings, Services, Control and Allow remote control via HTTP are names in Kodi's own menus.
#: src/lib.rs
msgid "Like http://192.168.0.20:8080, or http://localhost:8080 for Kodi on this TV. In Kodi's Settings, Services, Control, turn on Allow remote control via HTTP."
msgstr "Ad esempio http://192.168.0.20:8080, oppure http://localhost:8080 se Kodi è su questa TV. In Kodi vai in Impostazioni, Servizi, Controllo e attiva Consenti controllo remoto attraverso HTTP."

#. a setting and its help. The second kodi is the username itself, kept as it is.
#: src/lib.rs
msgid "Username"
msgstr "Nome utente"

#. a setting and its help. The second kodi is the username itself, kept as it is.
#: src/lib.rs
msgid "Kodi's default is kodi."
msgstr "Quello predefinito di Kodi è kodi."

#: src/lib.rs
msgid "Password"
msgstr "Password"

#: src/lib.rs
msgid "Kodi app"
msgstr "App Kodi"

#: src/lib.rs
msgid "The package brought to the front after Kodi starts playing."
msgstr "Il pacchetto portato in primo piano quando Kodi avvia la riproduzione."

#: src/lib.rs
msgid "Bring Kodi to the front"
msgstr "Porta Kodi in primo piano"

#: src/lib.rs
msgid "On when Kodi runs on this TV. Off when it is another box: it starts playing and this TV stays where it is."
msgstr "Sì se Kodi è su questa TV. No se è su un altro dispositivo: la riproduzione parte lì e questa TV resta dov'è."

#: src/lib.rs
msgid "Live TV channels"
msgstr "Canali TV in diretta"

#: src/lib.rs
msgid "Kodi's PVR channels in Live now and the guide."
msgstr "I canali PVR di Kodi nella riga In diretta e nella guida TV."

#: src/lib.rs
msgid "Kodi has no episodes of this show. Update Kodi's library, then try again."
msgstr "Kodi non ha episodi di questa serie. Aggiorna la libreria di Kodi, poi riprova."

#: src/lib.rs
msgid "Kodi would not play it. Refresh the plugin, then try again."
msgstr "Kodi non l'ha riprodotto. Aggiorna il plugin, poi riprova."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgctxt "in a sentence"
msgid "Kodi address"
msgstr "indirizzo di Kodi"

#. {address} is the address in the settings and {local} the one to use, such as http://localhost:8080.
#: src/lib.rs
msgid "The address {address} is this TV's own, which a plugin may not use. For Kodi on this TV, set the address to {local}."
msgstr "L'indirizzo {address} è quello di questa TV, che un plugin non può usare. Se Kodi è su questa TV, imposta l'indirizzo su {local}."

#: src/lib.rs
msgid "Kodi didn't answer at {address}. Check that it is running and allows remote control over HTTP, then try again."
msgstr "Kodi non ha risposto all'indirizzo {address}. Controlla che sia in esecuzione e che consenta il controllo remoto via HTTP, poi riprova."

#: src/lib.rs
msgid "Kodi refused the username or password. Check them in the plugin's settings."
msgstr "Kodi ha rifiutato il nome utente o la password. Controllali nelle impostazioni del plugin."
