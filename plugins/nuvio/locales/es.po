# Lounge, nuvio: es
#
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Nuvio rejected the email or password. Check them in the plugin's settings."
msgstr "Nuvio rechazó el correo electrónico o la contraseña. Compruébalos en los ajustes del plugin."

#: src/lib.rs
msgid "Continue watching, up next and your library from your Nuvio account's sync, opened in Nuvio."
msgstr "Seguir viendo, a continuación y tu biblioteca, desde la sincronización de tu cuenta de Nuvio, abiertos en Nuvio."

#: src/lib.rs
msgid "Library on Nuvio"
msgstr "Biblioteca en Nuvio"

#: src/lib.rs
msgid "Email"
msgstr "Correo electrónico"

#. a position is how far into a film or an episode someone stopped.
#: src/lib.rs
msgid "The email of your Nuvio account. Positions come from Nuvio's own sync: a profile that follows Trakt, Simkl or MDBList for its progress keeps none there, so use the Trakt plugin for that one."
msgstr "El correo electrónico de tu cuenta de Nuvio. Las posiciones vienen de la sincronización propia de Nuvio: un perfil que lleva su progreso con Trakt, Simkl o MDBList no guarda ninguna allí, así que para ese usa el plugin de Trakt."

#: src/lib.rs
msgid "Password"
msgstr "Contraseña"

#. one of the profiles of a Nuvio account, each a person with their own lists.
#: src/lib.rs
msgid "Profile"
msgstr "Perfil"

#: src/lib.rs
msgid "Leave empty for the first profile, or type another profile's name as Nuvio shows it."
msgstr "Déjalo vacío para el primer perfil, o escribe el nombre de otro perfil tal como lo muestra Nuvio."

#: src/lib.rs
msgid "Library row"
msgstr "Fila Biblioteca"

#: src/lib.rs
msgid "The movies and shows saved in your Nuvio library, newest first."
msgstr "Las películas y series guardadas en tu biblioteca de Nuvio, primero las más recientes."

#: src/lib.rs
msgid "TMDB API key"
msgstr "Clave de API de TMDB"

#. "API Key (v3)" and "Read Access Token" are what TMDB's settings page calls them.
#: src/lib.rs
msgid "Fill this in when tiles show a code like tmdb:1234 instead of a name. Use the API Key (v3) from themoviedb.org/settings/api, not the Read Access Token."
msgstr "Escríbela si las tarjetas muestran un código como tmdb:1234 en vez de un nombre. Usa la API Key (v3) de themoviedb.org/settings/api, no el Read Access Token."

#: src/lib.rs
msgid "Self-hosted server address"
msgstr "Dirección del servidor propio"

#: src/lib.rs
msgid "Leave empty for Nuvio's own. For a self-hosted backend, its address, like https://nuvio.example.com."
msgstr "Déjalo vacío para usar el de Nuvio. Si alojas tu propio servidor, su dirección, por ejemplo, https://nuvio.example.com."

#: src/lib.rs
msgid "Installed from Google Play"
msgstr "Instalado desde Google Play"

#: src/lib.rs
msgid "On if you installed Nuvio from Google Play, off if from GitHub or a downloaded APK."
msgstr "Sí: instalaste Nuvio desde Google Play. No: desde GitHub o con un APK descargado."

#. {name} is the profile name typed in the plugin's settings.
#: src/lib.rs
msgid "Nuvio has no profile called {name}. Leave the field empty for the first profile."
msgstr "Nuvio no tiene ningún perfil llamado {name}. Deja el campo vacío para usar el primer perfil."

#. {name} is the profile name typed in the plugin's settings, and {names} the account's profiles with commas between them.
#: src/lib.rs
msgid "Nuvio has no profile called {name}. Besides the first, it has: {names}."
msgstr "Nuvio no tiene ningún perfil llamado {name}. Además del primero, tiene: {names}."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "email"
msgstr "correo electrónico"

#: src/lib.rs
msgid "This Nuvio server doesn't allow signing in with an email and password, which is the only way this plugin can."
msgstr "Este servidor de Nuvio no permite iniciar sesión con correo electrónico y contraseña, y este plugin no puede hacerlo de otra forma."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "password"
msgstr "contraseña"

#: src/lib.rs
msgid "The Nuvio server turned the sign-in away. Lounge checks the server's settings again on the next refresh."
msgstr "El servidor de Nuvio rechazó el inicio de sesión. Lounge vuelve a consultar los ajustes del servidor en la próxima actualización."
