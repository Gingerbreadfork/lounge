# Lounge, nuvio: nl
#
msgid ""
msgstr ""
"Language: nl\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Nuvio rejected the email or password. Check them in the plugin's settings."
msgstr "Nuvio heeft het e-mailadres of het wachtwoord geweigerd. Controleer ze in de instellingen van de plug-in."

#: src/lib.rs
msgid "Continue watching, up next and your library from your Nuvio account's sync, opened in Nuvio."
msgstr "Verder kijken, hierna en je bibliotheek uit de synchronisatie van je Nuvio-account, geopend in Nuvio."

#: src/lib.rs
msgid "Library on Nuvio"
msgstr "Bibliotheek op Nuvio"

#: src/lib.rs
msgid "Email"
msgstr "E-mailadres"

#. a position is how far into a film or an episode someone stopped.
#: src/lib.rs
msgid "The email of your Nuvio account. Positions come from Nuvio's own sync: a profile that follows Trakt, Simkl or MDBList for its progress keeps none there, so use the Trakt plugin for that one."
msgstr "Het e-mailadres van je Nuvio-account. Kijkposities komen uit de eigen synchronisatie van Nuvio: een profiel dat zijn voortgang via Trakt, Simkl of MDBList bijhoudt, bewaart daar niets, dus gebruik daarvoor de Trakt-plug-in."

#: src/lib.rs
msgid "Password"
msgstr "Wachtwoord"

#. one of the profiles of a Nuvio account, each a person with their own lists.
#: src/lib.rs
msgid "Profile"
msgstr "Profiel"

#: src/lib.rs
msgid "Leave empty for the first profile, or type another profile's name as Nuvio shows it."
msgstr "Laat dit leeg voor het eerste profiel, of typ de naam van een ander profiel zoals Nuvio die toont."

#: src/lib.rs
msgid "Library row"
msgstr "Rij Bibliotheek"

#: src/lib.rs
msgid "The movies and shows saved in your Nuvio library, newest first."
msgstr "De films en series die in je Nuvio-bibliotheek zijn opgeslagen, de nieuwste eerst."

#: src/lib.rs
msgid "TMDB API key"
msgstr "API-sleutel van TMDB"

#. "API Key (v3)" and "Read Access Token" are what TMDB's settings page calls them.
#: src/lib.rs
msgid "Fill this in when tiles show a code like tmdb:1234 instead of a name. Use the API Key (v3) from themoviedb.org/settings/api, not the Read Access Token."
msgstr "Vul dit in als tegels een code als tmdb:1234 tonen in plaats van een naam. Gebruik de API Key (v3) van themoviedb.org/settings/api, niet het Read Access Token."

#: src/lib.rs
msgid "Self-hosted server address"
msgstr "Adres van eigen server"

#: src/lib.rs
msgid "Leave empty for Nuvio's own. For a self-hosted backend, its address, like https://nuvio.example.com."
msgstr "Laat dit leeg voor de server van Nuvio zelf. Gebruik voor een zelf gehoste backend het adres daarvan, zoals https://nuvio.example.com."

#: src/lib.rs
msgid "Installed from Google Play"
msgstr "Geïnstalleerd via Google Play"

#: src/lib.rs
msgid "On if you installed Nuvio from Google Play, off if from GitHub or a downloaded APK."
msgstr "Aan als je Nuvio via Google Play hebt geïnstalleerd, uit als het van GitHub of een gedownloade APK komt."

#. {name} is the profile name typed in the plugin's settings.
#: src/lib.rs
msgid "Nuvio has no profile called {name}. Leave the field empty for the first profile."
msgstr "Nuvio heeft geen profiel met de naam {name}. Laat het veld leeg voor het eerste profiel."

#. {name} is the profile name typed in the plugin's settings, and {names} the account's profiles with commas between them.
#: src/lib.rs
msgid "Nuvio has no profile called {name}. Besides the first, it has: {names}."
msgstr "Nuvio heeft geen profiel met de naam {name}. Naast het eerste zijn er: {names}."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "email"
msgstr "e-mailadres"

#: src/lib.rs
msgid "This Nuvio server doesn't allow signing in with an email and password, which is the only way this plugin can."
msgstr "Op deze Nuvio-server kun je niet inloggen met e-mailadres en wachtwoord, en dat is de enige manier die deze plug-in kent."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "password"
msgstr "wachtwoord"

#: src/lib.rs
msgid "The Nuvio server turned the sign-in away. Lounge checks the server's settings again on the next refresh."
msgstr "De Nuvio-server heeft het inloggen geweigerd. Bij de volgende vernieuwing bekijkt Lounge de instellingen van de server opnieuw."
