#: src/lib.rs
msgid "Live channels, the guide and your recordings from a Channels DVR server."
msgstr "Canais em direto, o guia e as suas gravações de um servidor Channels DVR."

#: src/lib.rs
msgid "Recordings on Channels DVR"
msgstr "Gravações no Channels DVR"

#: src/lib.rs
msgid "Server address"
msgstr "Endereço do servidor"

#: src/lib.rs
msgid "Like http://192.168.0.10:8089"
msgstr "Por exemplo, http://192.168.0.10:8089"

#: src/lib.rs
msgid "Only favourite channels"
msgstr "Só canais favoritos"

#. a setting that takes a number, and its help, which says which recordings are kept.
#: src/lib.rs
msgid "Recordings to show"
msgstr "Gravações a mostrar"

#. a setting that takes a number, and its help, which says which recordings are kept.
#: src/lib.rs
msgid "The newest ones."
msgstr "As mais recentes."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "endereço do servidor"

#: src/lib.rs
msgid "No Channels DVR answered at {address}. Check the server and its address, then try again."
msgstr "Nenhum Channels DVR respondeu em {address}. Verifique o servidor e o respetivo endereço e tente novamente."

#: src/lib.rs
msgid "Channels DVR has no channels to show. Add a source in its settings, or turn off the favourites filter."
msgstr "O Channels DVR não tem canais para mostrar. Adicione uma fonte nas definições dele ou desative o filtro de favoritos."
