#: src/lib.rs
msgid "Live channels, the guide and your recordings from a Channels DVR server."
msgstr "Canali in diretta, guida TV e le tue registrazioni da un server Channels DVR."

#: src/lib.rs
msgid "Recordings on Channels DVR"
msgstr "Registrazioni su Channels DVR"

#: src/lib.rs
msgid "Server address"
msgstr "Indirizzo del server"

#: src/lib.rs
msgid "Like http://192.168.0.10:8089"
msgstr "Ad esempio http://192.168.0.10:8089"

#: src/lib.rs
msgid "Only favourite channels"
msgstr "Solo i canali preferiti"

#. a setting that takes a number, and its help, which says which recordings are kept.
#: src/lib.rs
msgid "Recordings to show"
msgstr "Registrazioni da mostrare"

#. a setting that takes a number, and its help, which says which recordings are kept.
#: src/lib.rs
msgid "The newest ones."
msgstr "Le più recenti."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "indirizzo del server"

#: src/lib.rs
msgid "No Channels DVR answered at {address}. Check the server and its address, then try again."
msgstr "Nessun server Channels DVR ha risposto all'indirizzo {address}. Controlla il server e il suo indirizzo, poi riprova."

#: src/lib.rs
msgid "Channels DVR has no channels to show. Add a source in its settings, or turn off the favourites filter."
msgstr "Channels DVR non ha canali da mostrare. Aggiungi una sorgente nelle sue impostazioni, oppure disattiva il filtro dei preferiti."
