msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/lib.rs
msgid "Simkl is asking for a pause between requests. It tries again on the next refresh."
msgstr "Simkl chiede una pausa tra una richiesta e l'altra. Il plugin riproverà al prossimo aggiornamento."

#: src/lib.rs
msgid "Simkl does not know this Client ID, or has paused it. Check it against your app at simkl.com/settings/developer."
msgstr "Simkl non riconosce questo Client ID, oppure l'ha sospeso. Confrontalo con quello della tua app su simkl.com/settings/developer."

#. "TV, devices and command line" is a kind of app on Simkl's developer page, in Simkl's own words.
#: src/lib.rs
msgid "Simkl does not accept this Client ID for signing in. Apps made before Simkl's new sign-in do not work: at simkl.com/settings/developer create an app of the type TV, devices and command line, and use its Client ID."
msgstr "Simkl non accetta questo Client ID per l'accesso. Le app create prima del nuovo sistema di accesso di Simkl non funzionano: su simkl.com/settings/developer crea un'app di tipo TV, devices and command line e usa il suo Client ID."

#. "Refresh now" is the button on the plugin's page on the TV.
#: src/lib.rs
msgid "Simkl no longer accepts this sign-in. Press Refresh now for a new code."
msgstr "Simkl non accetta più questo accesso. Premi Aggiorna ora per avere un nuovo codice."

#: src/lib.rs
msgid "Could not renew the Simkl sign-in. It tries again on the next refresh."
msgstr "Non è stato possibile rinnovare l'accesso a Simkl. Il plugin riproverà al prossimo aggiornamento."

#: src/lib.rs
msgid "Continue watching, up next, plan to watch and the week's new episodes from Simkl, for shows, anime and films across every service."
msgstr "Continua a guardare, a seguire, da vedere e i nuovi episodi della settimana da Simkl, per serie, anime e film di qualsiasi servizio."

#: src/lib.rs
msgid "Up next on Simkl"
msgstr "A seguire su Simkl"

#: src/lib.rs
msgid "Coming up on Simkl"
msgstr "Prossimamente su Simkl"

#: src/lib.rs
msgid "Plan to watch on Simkl"
msgstr "Da vedere su Simkl"

#: src/lib.rs
msgid "Client ID"
msgstr "Client ID"

#. "TV, devices and command line" is a kind of app on Simkl's developer page, in Simkl's own words.
#: src/lib.rs
msgid "At simkl.com/settings/developer create an app of the type TV, devices and command line, any name, and copy its Client ID. Nothing else is needed; the sign-in code then appears on this page."
msgstr "Su simkl.com/settings/developer crea un'app di tipo TV, devices and command line, con un nome qualsiasi, e copia il suo Client ID. Non serve altro; il codice per accedere comparirà poi in questa pagina."

#: src/lib.rs
msgid "Up next row"
msgstr "Riga A seguire"

#: src/lib.rs
msgid "The next episode of each show and anime you are watching."
msgstr "Il prossimo episodio di ogni serie e anime che stai guardando."

#: src/lib.rs
msgid "Coming up row"
msgstr "Riga Prossimamente"

#: src/lib.rs
msgid "Episodes airing in the next week of the shows and anime you watch or plan to watch."
msgstr "Gli episodi in onda nei prossimi sette giorni delle serie e degli anime che guardi o che vuoi vedere."

#: src/lib.rs
msgid "Plan to watch row"
msgstr "Riga Da vedere"

#: src/lib.rs
msgid "Open with the TV's own search"
msgstr "Apri con la ricerca della TV"

#: src/lib.rs
msgid "On, a title opens in the TV's own search, which on Google TV lists where it streams. Off, Lounge searches your apps and plugins for it. A result of Lounge's search always opens the TV's search."
msgstr "Con Sì, un titolo si apre nella ricerca della TV, che su Google TV elenca dove è disponibile in streaming. Con No, Lounge lo cerca tra le tue app e i tuoi plugin. Un risultato della ricerca di Lounge apre sempre la ricerca della TV."

#: src/lib.rs
msgid "Search all of Simkl"
msgstr "Cerca in tutto Simkl"

#: src/lib.rs
msgid "On, Lounge's search asks Simkl's whole catalogue, which counts against your account's daily allowance. Off, it finds titles on your Simkl lists without asking Simkl."
msgstr "Con Sì, la ricerca di Lounge interroga l'intero catalogo di Simkl, e ogni ricerca consuma il limite giornaliero del tuo account. Con No, trova i titoli delle tue liste di Simkl senza interrogare Simkl."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "client ID"
msgstr "Client ID"

#: src/lib.rs
msgid "Simkl's daily allowance for this account is used up. The rows stay as they are until it comes back."
msgstr "Il limite giornaliero di Simkl per questo account è esaurito. Le righe restano come sono finché non si rinnova."

#. an anime episode by its number, among the facts under a title.
#: src/lib.rs
msgid "Episode {number}"
msgstr "Episodio {number}"

