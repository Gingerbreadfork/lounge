#: core/lounge-words/src/lib.rs
msgid "{first}, {next}"
msgstr "{first}, {next}"

#: core/lounge-words/src/lib.rs
msgid "{first} and {last}"
msgstr "{first} und {last}"

#: core/lounge-words/src/lib.rs
msgctxt "decimal mark"
msgid "."
msgstr ","

#: plugins/sdk/src/lib.rs
msgid "This plugin can't open that."
msgstr "Dieses Plugin kann das nicht öffnen."

#: plugins/sdk/src/lib.rs
msgid "This plugin has nothing more to show here."
msgstr "Dieses Plugin hat hier nichts weiter zu zeigen."

#. {shown} is a web address and {code} a short code. "Refresh now" is the button on the plugin's page on the TV.
#: plugins/sdk/src/lib.rs
msgid "Sign in: on your phone open {shown} and enter {code}, then press Refresh now here."
msgstr "Anmelden: Öffne auf deinem Handy {shown} und gib {code} ein, dann drücke hier „Jetzt aktualisieren“."

#: plugins/sdk/src/lib.rs
msgid "The answer is larger than the 8 MB a plugin may read."
msgstr "Die Antwort ist größer als die 8 MB, die ein Plugin lesen darf."

#: plugins/sdk/src/lib.rs
msgid "The plugin reached the most it may fetch in one refresh, so it stopped early. It tries again in a few minutes."
msgstr "Das Plugin hat erreicht, was es bei einer Aktualisierung höchstens abrufen darf, und deshalb vorzeitig aufgehört. In ein paar Minuten folgt ein neuer Versuch."

#: plugins/sdk/src/lib.rs
msgid "The server at {address} answered with error {status}. Check the address, then try again."
msgstr "Der Server unter {address} hat mit Fehler {status} geantwortet. Prüfe die Adresse und versuche es dann erneut."

#: plugins/sdk/src/lib.rs
msgid "The guide didn't come through, so the TV is showing the last one it had. It tries again in a few minutes."
msgstr "Das TV-Programm ist nicht angekommen, deshalb zeigt der Fernseher das letzte, das er hatte. In ein paar Minuten folgt ein neuer Versuch."

#: plugins/sdk/src/lib.rs
msgid "{service} didn't answer at {address}. Check the server, then try again."
msgstr "{service} hat unter {address} nicht geantwortet. Prüfe den Server und versuche es dann erneut."

#: plugins/sdk/src/lib.rs
msgid "{service} at {address} answered with error {status}. Check the server, then try again."
msgstr "{service} unter {address} hat mit Fehler {status} geantwortet. Prüfe den Server und versuche es dann erneut."

#: plugins/sdk/src/lib.rs
msgid "The server at {address} didn't answer like an {service} server. Check the server address in the plugin's settings."
msgstr "Der Server unter {address} hat nicht wie ein {service}-Server geantwortet. Prüfe die Serveradresse in den Plugin-Einstellungen."

#: plugins/sdk/src/lib.rs
msgid "The server at {address} didn't answer like a {service} server. Check the server address in the plugin's settings."
msgstr "Der Server unter {address} hat nicht wie ein {service}-Server geantwortet. Prüfe die Serveradresse in den Plugin-Einstellungen."

#: plugins/sdk/src/lib.rs
msgid "{service} at {address} sent a reply this plugin can't read."
msgstr "{service} unter {address} hat eine Antwort gesendet, die dieses Plugin nicht lesen kann."

#: plugins/sdk/src/lib.rs
msgid "{service} didn't answer. Check the TV's internet connection, then try again."
msgstr "{service} hat nicht geantwortet. Prüfe die Internetverbindung des Fernsehers und versuche es dann erneut."

#: plugins/sdk/src/lib.rs
msgid "{service} answered with error {status}. Try again later."
msgstr "{service} hat mit Fehler {status} geantwortet. Versuche es später erneut."

#. {label} names a setting, already translated, such as "server address". Word the sentence so the name can stand as it is, for example after a colon.
#: plugins/sdk/src/lib.rs
msgid "Add the {label} in the plugin's settings."
msgstr "Das fehlt noch in den Plugin-Einstellungen: {label}."
