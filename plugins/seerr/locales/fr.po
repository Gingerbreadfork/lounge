msgid ""
msgstr ""
"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#: src/lib.rs
msgid "Seerr didn't accept the API key. Check it in the plugin's settings."
msgstr "Seerr n’a pas accepté la clé API. Vérifiez-la dans les paramètres du plugin."

#: src/lib.rs
msgid "What has been requested and is on its way, and what has just become available, from Seerr, Jellyseerr or Overseerr."
msgstr "Ce qui a été demandé et arrive bientôt, et ce qui vient d’être disponible, depuis Seerr, Jellyseerr ou Overseerr."

#: src/lib.rs
msgid "Requested on Seerr"
msgstr "Demandes sur Seerr"

#: src/lib.rs
msgid "Now available on Seerr"
msgstr "Désormais disponible sur Seerr"

#: src/lib.rs
msgid "Server address"
msgstr "Adresse du serveur"

#: src/lib.rs
msgid "Like http://192.168.0.10:5055"
msgstr "Par exemple http://192.168.0.10:5055"

#: src/lib.rs
msgid "API key"
msgstr "Clé API"

#. "Settings, General" is where the key is in Seerr's own menus. The phone companion is Lounge's page on a phone.
#: src/lib.rs
msgid "In Seerr, Jellyseerr or Overseerr under Settings, General. It is easiest pasted from the phone companion."
msgstr "Dans Seerr, Jellyseerr ou Overseerr, sous Paramètres, Général. Le plus simple est de la coller depuis Lounge sur téléphone."

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgid "server address"
msgstr "adresse du serveur"

#. names the setting inside "Add the {label} in the plugin's settings."
#: src/lib.rs
msgctxt "inside a sentence"
msgid "API key"
msgstr "clé API"

#. the state of a request for a film or a show, at the start of the line under its title.
#: src/lib.rs
msgid "Waiting for approval"
msgstr "En attente d’approbation"

#. the same state after a comma, as in "Season 1, waiting for approval".
#: src/lib.rs
msgid "waiting for approval"
msgstr "en attente d’approbation"

#: src/lib.rs
msgid "The request failed"
msgstr "La demande a échoué"

#. after a comma, as in "Season 1, the request failed".
#: src/lib.rs
msgid "the request failed"
msgstr "la demande a échoué"

#. {percent} is how much of the download is done, as in "Downloading, 40%".
#: src/lib.rs
msgid "Downloading, {percent}%"
msgstr "Téléchargement, {percent} %"

#. after a comma, as in "2 seasons, downloading, 40%".
#: src/lib.rs
msgid "downloading, {percent}%"
msgstr "téléchargement, {percent} %"

#. some of the episodes or seasons asked for have arrived.
#: src/lib.rs
msgid "Partly available"
msgstr "Partiellement disponible"

#. after a comma, as in "2 seasons, partly available".
#: src/lib.rs
msgid "partly available"
msgstr "partiellement disponible"

#. the request is approved and what was asked for has not arrived yet.
#: src/lib.rs
msgid "On its way"
msgstr "Arrive bientôt"

#. after a comma, as in "Season 1, on its way".
#: src/lib.rs
msgid "on its way"
msgstr "arrive bientôt"

#. the one season of a show that was requested, by its number.
#: src/lib.rs
msgid "Season {number}"
msgstr "Saison {number}"

#. how many seasons of a show were requested, always two or more.
#: src/lib.rs
msgid "{n} season"
msgid_plural "{n} seasons"
msgstr[0] "{n} saison"
msgstr[1] "{n} saisons"

#. {name} is the Seerr user who asked for the film or show.
#: src/lib.rs
msgid "Requested by {name}"
msgstr "Demandé par {name}"

#. after a comma, as in "2008, requested by sam".
#: src/lib.rs
msgid "requested by {name}"
msgstr "demandé par {name}"
