msgstr "Noch nichts protokolliert."

#. {key} is the first eight characters of the key the plugin's publisher signs with
#: src/pages/Plugins.svelte
msgid "Updates are taken only from its publisher, whose key starts {key}."
msgstr "Updates werden nur von seinem Herausgeber angenommen, dessen Schlüssel mit {key} beginnt."

#: src/pages/Plugins.svelte
msgid "Remove plugin"
msgstr "Plugin entfernen"

#: src/pages/Plugins.svelte
msgid "Yes, remove it and its settings"
msgstr "Ja, samt Einstellungen entfernen"

#: src/pages/Plugins.svelte
msgid "They add rows, channels and guide data from your services. Each plugin can reach only the places it names, and sees only its own settings."
msgstr "Sie bringen Reihen, Sender und Programmdaten von deinen Diensten. Jedes Plugin erreicht nur die Orte, die es nennt, und sieht nur seine eigenen Einstellungen."

#. under a plugin's name: how many items it brings and its version number
#: src/pages/Plugins.svelte
msgid "{n} item, version {version}"
msgid_plural "{n} items, version {version}"
msgstr[0] "{n} Eintrag, Version {version}"
msgstr[1] "{n} Einträge, Version {version}"

#. under a plugin's name: how many items it brings and its version number
#: src/pages/Plugins.svelte
msgid "version {version}"
msgstr "Version {version}"

