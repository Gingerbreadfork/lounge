// Silk: folds of satin turning slowly under the lamp.
uniform float2 resolution;
uniform float time;
layout(color) uniform half4 velvet;
layout(color) uniform half4 horizon;
layout(color) uniform half4 houselight;
layout(color) uniform half4 dust;

float folds(float2 p, float t) {
    float2 q = p;
    for (int i = 1; i < 4; i++) {
        float fi = float(i);
        q.x += 0.30 / fi * sin(fi * 2.1 * q.y + t * (1.0 + 0.3 * fi) + fi);
        q.y += 0.22 / fi * sin(fi * 1.7 * q.x - t * (0.8 + 0.2 * fi) + 2.0 * fi);
    }
    return sin(q.y * 22.0 + q.x * 4.0);
}

half4 main(float2 coord) {
    float2 p = (coord - 0.5 * resolution) / resolution.y * 1.4;
    float t = time * 0.03;
    float h = folds(p, t);
    float e = 1.0 / resolution.y;
    float hx = (folds(p + float2(e, 0.0), t) - h) / e;
    float hy = (folds(p + float2(0.0, e), t) - h) / e;
    float3 n = normalize(float3(-hx * 0.025, -hy * 0.025, 1.0));
    float3 l = normalize(float3(-0.4, -0.5, 0.75));
    float3 hv = normalize(l + float3(0.0, 0.0, 1.0));
    float diffuse = clamp(dot(n, l), 0.0, 1.0);
    float facing = clamp(dot(n, hv), 0.0, 1.0);
    float sheen = 0.6 * pow(facing, 60.0) + 0.18 * pow(facing, 8.0);
    float swell = 0.7 + 0.3 * sin(p.x * 1.3 + p.y * 0.7 + t * 1.5);
    half3 cloth = mix(velvet.rgb * 1.1, horizon.rgb * 2.4, half(0.5 + 0.5 * h));
    half3 col = cloth * half((0.2 + 0.8 * diffuse) * swell) + mix(dust.rgb, houselight.rgb, 0.3) * half(sheen * swell);
    return half4(col, 1.0);
}
