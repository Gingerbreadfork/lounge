// Smoke: wisps rising from something put out a moment ago, thinning as they climb.
uniform float2 resolution;
uniform float time;
uniform shader noise;
layout(color) uniform half4 velvet;
layout(color) uniform half4 horizon;
layout(color) uniform half4 houselight;
layout(color) uniform half4 dust;

float fbm(float2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * float(noise.eval(p * 16.0).g);
        p = float2(1.6 * p.x + 1.2 * p.y, -1.2 * p.x + 1.6 * p.y) + float2(5.3, 1.7);
        a *= 0.5;
    }
    return v;
}

half4 main(float2 coord) {
    float2 p = float2((coord.x - 0.5 * resolution.x) / resolution.y, 1.0 - coord.y / resolution.y) * 1.6;
    float t = time * 0.045;
    float2 q = p * float2(1.0, 0.7);
    q.y -= t * 1.6;
    float2 warp = float2(fbm(q * 1.1 - float2(0.0, t * 0.3)), fbm(q * 1.1 + float2(5.2, 1.3)));
    float d = fbm(q + 1.4 * (warp - 0.5) + float2(t * 0.2, 0.0));
    float ridged = 1.0 - abs(d * 2.0 - 1.0);
    float wisps = smoothstep(0.55, 0.98, ridged) * smoothstep(0.1, 0.5, d);
    // Rising from one place at the bottom, spreading a little as it climbs, and gone by the top.
    float column = exp(-p.x * p.x * 2.2);
    float spread = mix(column, 0.55, smoothstep(0.1, 1.5, p.y));
    float thin = 1.0 - smoothstep(0.1, 1.5, p.y);
    float amount = clamp(wisps * spread * thin * 1.1, 0.0, 1.0);

    half3 body = mix(mix(horizon.rgb * 2.0, dust.rgb, half(0.45)), dust.rgb * 0.8, half(smoothstep(0.2, 1.2, p.y)));
    half3 col = velvet.rgb * half(0.8 - 0.15 * p.y);
    col = mix(col, body, half(amount));
    col += houselight.rgb * half(0.2 * exp(-(p.y + 0.05) * 5.0) * column);
    return half4(col, 1.0);
}
