// Moonpath: the sea at night, and the road the moon lays across it.
uniform float2 resolution;
uniform float time;
uniform shader noise;
layout(color) uniform half4 velvet;
layout(color) uniform half4 horizon;
layout(color) uniform half4 houselight;
layout(color) uniform half4 dust;

const float SEA = 0.2;
const float2 MOON = float2(0.42, 0.32);

float n(float2 p) {
    return float(noise.eval(p * 16.0).r);
}

// The sky along a direction, by its height above the sea and how near it is to the moon.
half3 sky(float3 d, float3 moon) {
    float up = max(d.y, 0.0);
    half3 c = mix(mix(horizon.rgb * 1.7, dust.rgb * 0.3, 0.25), velvet.rgb * 0.45, half(smoothstep(0.0, 0.32, up)));
    float near = max(dot(d, moon), 0.0);
    float glow = near * near;
    glow *= glow;
    glow *= glow;
    c += houselight.rgb * half(0.2 * glow * glow + 0.05 * glow);
    return c;
}

// The chop and the ripples on the swell as a height, each fading out before it is too fine
// for a pixel to show.
float waves(float2 w, float t, float footprint) {
    float chop = n(w * float2(0.45, 1.9) + float2(0.07 * t, -0.3 * t)) * smoothstep(0.55, 0.15, footprint * 1.9);
    float ripple = n(w * float2(1.4, 5.2) + float2(-0.1 * t, -0.6 * t) + 7.0) * smoothstep(0.55, 0.15, footprint * 5.2);
    return 0.16 * chop + 0.045 * ripple;
}

half4 main(float2 coord) {
    float2 p = float2((coord.x - 0.5 * resolution.x) / resolution.y, 0.5 - coord.y / resolution.y);
    float t = time * 0.3;
    float3 moon = normalize(float3(MOON.x, MOON.y - SEA, 1.0));
    float3 view = normalize(float3(p.x, p.y - SEA, 1.0));

    if (p.y > SEA) {
        half3 c = sky(view, moon);
        float2 m = p - MOON;
        float rim = exp(-dot(m, m) * 40.0);
        // Long thin cloud drifting past the moon, lit at its edges where the moon is behind it.
        float strand = n(float2(p.x * 0.7 + time * 0.003, p.y * 9.0)) * n(float2(p.x * 1.9 - time * 0.002, p.y * 15.0 + 3.0));
        float cloud = smoothstep(0.2, 0.55, strand) * smoothstep(SEA + 0.03, SEA + 0.1, p.y);
        float disc = smoothstep(0.027, 0.024, length(m)) * (1.0 - 0.85 * cloud);
        float seas = 0.86 + 0.14 * n(m * 9.0 + 2.0);
        c = mix(c, mix(houselight.rgb, half3(1.0), 0.4) * half(seas), half(disc));
        c = mix(c, c * 0.8 + mix(dust.rgb, houselight.rgb, 0.6) * half(0.5 * rim), half(cloud * 0.7));
        return half4(c, 1.0);
    }

    // Where this pixel meets the sea, and how much sea one pixel covers there.
    float below = SEA - p.y;
    float z = 1.0 / below;
    float2 w = float2(p.x * z, z);
    float footprint = z * z / resolution.y;

    // Two long swells, and the chop on them.
    float2 slope = float2(0.0);
    float swell = smoothstep(0.9, 0.2, footprint * 0.5);
    slope += 0.12 * swell * float2(0.25, 1.0) * cos(dot(w, float2(0.25, 1.0)) * 0.55 + t * 0.6);
    slope += 0.08 * swell * float2(-0.5, 0.85) * cos(dot(w, float2(-0.5, 0.85)) * 0.8 - t * 0.7 + 1.3);
    // A step of a few texels, so the texture's own steps do not show as rings.
    float e = 0.07;
    float h0 = waves(w, t, footprint);
    slope += float2(waves(w + float2(e, 0.0), t, footprint) - h0, waves(w + float2(0.0, e), t, footprint) - h0) / e;

    float3 normal = normalize(float3(-slope.x, 1.0, -slope.y));
    float3 r = reflect(view, normal);
    r.y = abs(r.y);
    float fresnel = 0.03 + 0.97 * pow(1.0 - clamp(dot(-view, normal), 0.0, 1.0), 5.0);
    half3 water = velvet.rgb * 0.35 + horizon.rgb * 0.2;
    half3 c = mix(water, sky(r, moon), half(fresnel));
    // The moon's road: the water tilting toward the moon, broad and soft, with glints in it.
    float toward = max(dot(r, moon), 0.0);
    float road = pow(toward, 60.0);
    float glint = pow(toward, 700.0);
    c += houselight.rgb * half(0.4 * road + 0.8 * glint);
    // A faint mist where the sea meets the sky.
    c = mix(c, horizon.rgb * 1.6, half(0.3 * exp(-below * 30.0)));
    return half4(c, 1.0);
}
