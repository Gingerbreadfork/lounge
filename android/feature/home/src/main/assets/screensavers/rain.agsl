// Rain: a window at night. Drops run down the glass in their own time, each lit from the street
// below, over the soft bokeh of lamps too far away to make out.
uniform float2 resolution;
uniform float time;
layout(color) uniform half4 velvet;
layout(color) uniform half4 horizon;
layout(color) uniform half4 houselight;
layout(color) uniform half4 ember;
layout(color) uniform half4 dust;

float2 hash2(float2 p) {
    float3 p3 = fract(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

// One sheet of running drops. A tall cell may hold one drop, which slides down over some seconds,
// swaying a little, sits at the bottom and fades, then a new one starts at the top. Returns the
// drop's cover, its wet trail and the crescent of light on its lower edge.
float3 sheet(float2 uv, float t, float cols, float rows, float seed) {
    float2 c = float2(uv.x * cols + seed, uv.y * rows + seed * 0.37);
    float2 id = floor(c);
    float2 f = fract(c) - 0.5;
    float2 rnd = hash2(id);
    float present = step(0.45, rnd.x);
    float phase = fract(t * (0.04 + 0.035 * rnd.x) + rnd.y * 7.0);
    float run = smoothstep(0.0, 0.7, phase);
    float y = -0.42 + 0.84 * (run * run * (3.0 - 2.0 * run));
    float x = 0.26 * (rnd.x - 0.5) + 0.06 * sin(run * 9.0 + rnd.y * 12.0);
    float alive = smoothstep(0.0, 0.05, phase) * (1.0 - smoothstep(0.75, 0.98, phase)) * present;
    float2 d = float2((f.x - x) * rows / cols, f.y - y);
    float r = 0.045 + 0.04 * fract(rnd.y * 3.0);
    float body = length(d * float2(1.0, 0.8));
    float drop = smoothstep(r, r * 0.8, body) * alive;
    float light = smoothstep(r * 0.9, r * 0.5, length(d - float2(0.0, r * 0.3))) * (1.0 - smoothstep(r * 0.45, r * 0.7, body)) * alive;
    float above = y - f.y;
    float trail = smoothstep(0.008, 0.0, abs(d.x)) * step(0.0, above) * (1.0 - smoothstep(0.0, 0.5, above)) * run * alive * (1.0 - drop);
    return float3(drop, trail, light);
}

// Small drops that sit on the glass and catch a little of the light without moving.
float2 beads(float2 uv, float cols, float rows, float seed) {
    float2 c = float2(uv.x * cols + seed, uv.y * rows);
    float2 id = floor(c);
    float2 f = fract(c) - 0.5;
    float2 rnd = hash2(id + seed);
    float present = step(0.72, rnd.x);
    float2 d = float2((f.x - 0.5 * (rnd.y - 0.5)) * rows / cols, f.y - 0.5 * (rnd.x - 0.5));
    float r = 0.05 + 0.07 * fract(rnd.y * 7.0);
    float body = length(d);
    float drop = smoothstep(r, r * 0.7, body) * present;
    float light = smoothstep(r * 0.9, r * 0.4, length(d - float2(0.0, r * 0.35))) * (1.0 - smoothstep(r * 0.35, r * 0.6, body)) * present;
    return float2(drop, light);
}

half4 main(float2 coord) {
    float aspect = resolution.x / resolution.y;
    float2 uv = coord / resolution.y;
    float2 p = float2(uv.x - 0.5 * aspect, 1.0 - uv.y);
    float t = time;

    // The street: dark above, a lit haze low down, and a few lamps as soft discs.
    half3 col = mix(velvet.rgb * 0.75, horizon.rgb * 1.6, half(smoothstep(0.9, 0.0, p.y)));
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float2 rnd = hash2(float2(fi * 3.1, 17.0));
        float2 lamp = float2((rnd.x - 0.5) * aspect * 1.1, 0.1 + 0.3 * rnd.y);
        float radius = 0.09 + 0.1 * fract(rnd.x * 5.0);
        float glow = exp(-dot(p - lamp, p - lamp) / (radius * radius));
        float breathe = 0.85 + 0.15 * sin(t * (0.3 + 0.4 * rnd.y) + fi * 2.0);
        half3 lampColor = mix(houselight.rgb, ember.rgb, half(fract(rnd.y * 3.0)));
        col += lampColor * half(glow * breathe * (0.6 - 0.06 * fi));
    }
    col *= half(0.85 - 0.2 * smoothstep(0.4, 1.0, abs(p.x) / aspect * 2.0));

    float3 a = sheet(uv, t, 9.0, 4.0, 0.0);
    float3 b = sheet(uv, t * 1.13, 15.0, 7.0, 5.3);
    float2 s = beads(uv, 30.0, 18.0, 2.0);
    float drop = max(max(a.x, b.x), s.x);
    float trail = max(a.y, b.y);
    float light = a.z + 0.7 * b.z + 0.35 * s.y;

    // A drop gathers the street behind it: a touch brighter, and lit along its lower edge.
    col = mix(col, col * 1.2 + houselight.rgb * 0.03, half(drop));
    col += dust.rgb * half(0.1 * trail);
    col += houselight.rgb * half(0.32 * light);
    return half4(col, 1.0);
}
