<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The list of installed plugins, in Settings. -->
    <string name="plugins_title">Plugins</string>
    <string name="plugins_subtitle">They add rows, channels and guide data from your services.</string>
    <string name="plugins_loading">Loading…</string>
    <string name="plugins_none">No plugins installed. They install from the phone companion: on your phone, open Plugins.</string>
    <string name="plugins_footnote_reach">Each plugin can reach only the places it names, and sees only its own settings.</string>
    <string name="plugins_footnote_more">More plugins install from the phone companion.</string>

    <!-- A plugin's state, beside its name in the list. One that is running says On, and one switched off says Off. -->
    <!-- A plugin's state in the list: turned on, or turned off. -->
    <string name="plugins_status_on">On</string>
    <string name="plugins_status_off">Off</string>
    <string name="plugins_status_sign_in">Sign in</string>
    <string name="plugins_status_needs_setup">Needs setup</string>
    <string name="plugins_status_problem">Problem</string>
    <string name="plugins_status_held">Turned off by its update</string>

    <!-- The page of a plugin that was removed while its page was open. -->
    <string name="plugins_gone_title">Plugin</string>
    <string name="plugins_gone_subtitle">This plugin is no longer installed.</string>
    <string name="plugins_gone_back">Back to Plugins</string>

    <!-- Under a plugin's name. %1$s is its version number. -->
    <string name="plugins_version">Version %1$s</string>
    <!-- %1$s is the version number and %2$s the publisher's name. -->
    <string name="plugins_version_by">Version %1$s, by %2$s</string>

    <!-- A plugin whose update wants to connect to more places. %1$s lists them, such as "a.example and b.example". -->
    <string name="plugins_held">Turned off by its update, which also asks to reach %1$s.</string>
    <string name="plugins_allow">Allow and turn on</string>
    <!-- Under "Allow and turn on". %1$s lists the places, such as "a.example and b.example". -->
    <string name="plugins_allow_subtitle">It can then reach %1$s as well</string>

    <!-- Over the plugin's own settings. -->
    <string name="plugins_settings">Settings</string>
    <!-- %1$s is the plugin's name. -->
    <string name="plugins_turn_on">Turn on %1$s</string>
    <!-- Under "Turn on". %1$s is the label of a setting that is still empty. -->
    <string name="plugins_fill_in_first">Fill in %1$s first</string>
    <string name="plugins_refresh">Refresh now</string>
    <string name="plugins_refreshing">Refreshing…</string>
    <!-- The row that shows or hides what the plugin has logged. -->
    <string name="plugins_log">Log</string>
    <string name="plugins_log_empty">Nothing logged yet.</string>
    <string name="plugins_remove">Remove</string>
    <!-- The Remove row after its first press, asking for a second. -->
    <string name="plugins_remove_confirm">Yes, remove it and its settings</string>
    <!-- Said once a plugin is removed. %1$s is its name. -->
    <string name="plugins_removed">%1$s removed</string>

    <!-- Where a plugin may connect. %1$s lists the places, such as "example.com and this TV". -->
    <string name="plugins_reach">It can reach %1$s.</string>
    <string name="plugins_reach_self_signed">It can reach %1$s, accepting a home server\'s own certificate.</string>
    <string name="plugins_reach_nothing">It can reach nothing.</string>
    <!-- Places in the list inside "It can reach …". %1$s is the label of one of the plugin's settings. -->
    <string name="plugins_reach_setting">what you enter in %1$s</string>
    <string name="plugins_reach_anywhere">any public site</string>
    <string name="plugins_reach_home_network">devices on your home network</string>
    <string name="plugins_reach_this_tv">this TV</string>
    <!-- A list of places in a sentence: "a, b and c". The first joins each one before the last, the second adds the last. -->
    <string name="plugins_list_next">%1$s, %2$s</string>
    <string name="plugins_list_last">%1$s and %2$s</string>

    <!-- How often a plugin fetches, by the second or by the minute. -->
    <plurals name="plugins_refreshes_seconds">
        <item quantity="one">It refreshes every %1$d second while Lounge is on the screen.</item>
        <item quantity="other">It refreshes every %1$d seconds while Lounge is on the screen.</item>
    </plurals>
    <plurals name="plugins_refreshes_minutes">
        <item quantity="one">It refreshes every %1$d minute while the TV is on.</item>
        <item quantity="other">It refreshes every %1$d minutes while the TV is on.</item>
    </plurals>
    <!-- %1$s is the first eight characters of the publisher's key. -->
    <string name="plugins_publisher_key">Updates are taken only from its publisher, whose key starts %1$s.</string>

    <!-- A plugin that waits for a sign-in. The heading, then where to go; "its camera" is the phone's. -->
    <string name="plugins_ask_sign_in_phone">Sign in on your phone</string>
    <string name="plugins_ask_sign_in">Sign in</string>
    <!-- %1$s is a web address to open, such as plex.tv/link. -->
    <string name="plugins_ask_open">Scan this with its camera, or open %1$s</string>
    <!-- The code to enter is shown on the next line. -->
    <string name="plugins_ask_open_enter">Scan this with its camera, or open %1$s and enter</string>
    <string name="plugins_ask_tap">Scan this with its camera, or tap the link in the phone companion</string>
    <!-- The code to enter is shown on the next line. -->
    <string name="plugins_ask_tap_enter">Scan this with its camera, or tap the link in the phone companion and enter</string>

    <!-- A running plugin's state. %2$s is how long ago it last fetched, such as "5 minutes ago". -->
    <plurals name="plugins_items_refreshed">
        <item quantity="one">%1$d item, refreshed %2$s</item>
        <item quantity="other">%1$d items, refreshed %2$s</item>
    </plurals>
    <string name="plugins_fetching_first">Fetching for the first time…</string>
    <string name="plugins_fill_in_settings">Fill in the settings below, then turn it on.</string>

    <!-- A setting's long help cut to its first sentence, which is %1$s. -->
    <string name="plugins_help_on_phone">%1$s Your phone shows the full steps.</string>
    <!-- The label of a setting that may be left empty. %1$s is the label. -->
    <string name="plugins_setting_optional">%1$s (optional)</string>
    <!-- In an empty field whose secret value is kept and never shown. -->
    <string name="plugins_setting_secret_saved">•••••••• (saved)</string>
    <string name="plugins_setting_not_set">Not set</string>
    <!-- What a screen reader says of an empty field: its secret is kept, or what is used in its place. -->
    <string name="plugins_setting_saved">Saved</string>
    <string name="plugins_setting_not_set_uses">Not set, uses %1$s</string>
</resources>
