<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No splash: the window is velvet from the first frame and Compose draws over it. -->
    <style name="Theme.Lounge" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/velvet</item>
        <item name="android:colorBackground">@color/velvet</item>
        <item name="android:navigationBarColor">@color/velvet</item>
        <item name="android:statusBarColor">@color/velvet</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
