msgstr "{file} ontbreekt"

#. {file} names a file inside the plugin. Fills {reason} in "This file isn't a plugin Lounge can install: {reason}."
#: lounge-plugins/src/bundle.rs
msgid "{file} is too large"
msgstr "{file} is te groot"

#. {file} names a file inside the plugin. Fills {reason} in "This file isn't a plugin Lounge can install: {reason}."
#: lounge-plugins/src/bundle.rs
msgid "{file} is malformed"
msgstr "{file} is ongeldig"

#. {file} names a file inside the plugin. Fills {reason} in "This file isn't a plugin Lounge can install: {reason}."
#: lounge-plugins/src/bundle.rs
msgid "{file} has the wrong length"
msgstr "{file} heeft de verkeerde lengte"

#. fills {reason} in "This file isn't a plugin Lounge can install: {reason}."
#: lounge-plugins/src/bundle.rs
msgid "it is not a zip file"
msgstr "het is geen zipbestand"

