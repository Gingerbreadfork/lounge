# Lounge, core: de
#
msgid ""
msgstr ""
"Language: de\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. names a paired device by its browser and what it is, as in "Chrome on Pixel 8".
#: lounge-companion/src/auth.rs lounge-companion/src/server.rs
msgid "{browser} on {device}"
msgstr "{browser} auf {device}"

#: lounge-companion/src/server.rs
msgid "Pair this phone with the TV first."
msgstr "Kopple dieses Handy zuerst mit dem Fernseher."

#: lounge-companion/src/server.rs
msgid "The TV has forgotten this phone. Pair it again to carry on."
msgstr "Der Fernseher hat dieses Handy vergessen. Kopple es erneut, um weiterzumachen."

#: lounge-companion/src/server.rs
msgid "The TV answers only phones on its own network. Join the TV's Wi-Fi, then try again."
msgstr "Der Fernseher antwortet nur Handys in seinem eigenen Netz. Verbinde dich mit dem WLAN des Fernsehers und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "Open the phone companion at the address the TV shows. In Settings on the TV, open Phone companion to find it."
msgstr "Öffne Lounge fürs Handy unter der Adresse, die der Fernseher zeigt. Du findest sie auf dem Fernseher in den Einstellungen unter „Lounge fürs Handy“."

#. "New code" is a button on the TV's Phone companion screen.
#: lounge-companion/src/server.rs
msgid "That code has been used or has expired. Choose New code on the TV and try again."
msgstr "Dieser Code wurde schon benutzt oder ist abgelaufen. Wähle auf dem Fernseher „Neuer Code“ und versuche es erneut."

#: lounge-companion/src/server.rs
msgid "Phone"
msgstr "Handy"

#: lounge-companion/src/server.rs
msgid "Too many wrong codes. Scan the QR code on the TV instead, or wait a few minutes and try again."
msgstr "Zu viele falsche Codes. Scanne stattdessen den QR-Code auf dem Fernseher oder warte ein paar Minuten und versuche es erneut."

#: lounge-companion/src/server.rs
msgid "Type the six digits the TV shows."
msgstr "Gib die sechs Ziffern ein, die der Fernseher zeigt."

#: lounge-companion/src/server.rs
msgid "The TV couldn't save this phone, so it isn't paired. Check the TV has free space, then try again."
msgstr "Der Fernseher konnte dieses Handy nicht speichern, deshalb ist es nicht gekoppelt. Prüfe, ob der Fernseher freien Speicherplatz hat, und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't start a session for this phone. Try again in a moment."
msgstr "Der Fernseher konnte keine Sitzung für dieses Handy starten. Versuche es gleich erneut."

#: lounge-companion/src/server.rs
msgid "Android phone"
msgstr "Android-Handy"

#: lounge-companion/src/server.rs
msgid "Windows PC"
msgstr "Windows-PC"

#. names a paired device whose browser is not known. {device} is what it is, such as "iPhone" or "Phone".
#: lounge-companion/src/server.rs
msgid "A browser on {device}"
msgstr "Ein Browser auf {device}"

#: lounge-companion/src/server.rs
msgid "Lounge on the TV ran into a problem. Try again in a moment."
msgstr "Lounge auf dem Fernseher ist auf ein Problem gestoßen. Versuche es gleich erneut."

#: lounge-companion/src/server.rs lounge-core/src/companion.rs
msgid "The TV didn't take that key. Try again."
msgstr "Der Fernseher hat diese Taste nicht angenommen. Versuche es erneut."

#: lounge-companion/src/server.rs lounge-core/src/companion.rs
msgid "The TV didn't take the text. Try again."
msgstr "Der Fernseher hat den Text nicht angenommen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't open that. Try it from the TV."
msgstr "Der Fernseher konnte das nicht öffnen. Versuche es direkt am Fernseher."

#: lounge-companion/src/server.rs lounge-core/src/companion.rs
msgid "The TV couldn't open that app. Is it still installed?"
msgstr "Der Fernseher konnte diese App nicht öffnen. Ist sie noch installiert?"

#: lounge-companion/src/server.rs lounge-core/src/companion.rs
msgid "The TV couldn't start the search. Try again."
msgstr "Der Fernseher konnte die Suche nicht starten. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't save that change. Try again."
msgstr "Der Fernseher konnte diese Änderung nicht speichern. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "That file is too big for the TV."
msgstr "Diese Datei ist zu groß für den Fernseher."

#: lounge-companion/src/server.rs
msgid "The file didn't arrive in full. Try again."
msgstr "Die Datei ist nicht vollständig angekommen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The file stopped arriving. Check this phone's Wi-Fi, then try again."
msgstr "Die Datei kommt nicht mehr an. Prüfe das WLAN dieses Handys und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't store the file. Check it has free space, then try again."
msgstr "Der Fernseher konnte die Datei nicht speichern. Prüfe, ob er freien Speicherplatz hat, und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "Lounge on the TV is stopping. Try again in a moment."
msgstr "Lounge auf dem Fernseher wird gerade beendet. Versuche es gleich erneut."

#: lounge-companion/src/server.rs
msgid "That file is empty. Choose the plugin's .lgp file."
msgstr "Diese Datei ist leer. Wähle die .lgp-Datei des Plugins."

#: lounge-companion/src/server.rs
msgid "The TV couldn't install that plugin. Check it is a Lounge plugin, then try again."
msgstr "Der Fernseher konnte dieses Plugin nicht installieren. Prüfe, ob es ein Lounge-Plugin ist, und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't install from that link. Check the address, then try again."
msgstr "Der Fernseher konnte von diesem Link nicht installieren. Prüfe die Adresse und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't save that setting. Try again."
msgstr "Der Fernseher konnte diese Einstellung nicht speichern. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't read that from the plugin. Try again."
msgstr "Der Fernseher konnte das nicht vom Plugin lesen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't do that. Try again."
msgstr "Der Fernseher konnte das nicht ausführen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The picture isn't arriving."
msgstr "Das Bild kommt nicht an."

#: lounge-companion/src/server.rs lounge-core/src/engine.rs
msgid "The picture has no address now."
msgstr "Das Bild hat gerade keine Adresse."

#: lounge-companion/src/server.rs
msgid "The TV couldn't list its controls. Try again."
msgstr "Der Fernseher konnte seine Bedienelemente nicht auflisten. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV didn't answer. Check that HDMI-CEC is on in the TV's settings, then try again."
msgstr "Der Fernseher hat nicht geantwortet. Prüfe, ob HDMI-CEC in den Einstellungen des Fernsehers an ist, und versuche es dann erneut."

#: lounge-companion/src/server.rs
msgid "That isn't the key the TV made for pop-ups. Make a new one in the phone companion, under More."
msgstr "Das ist nicht der Schlüssel, den der Fernseher für Pop-ups erstellt hat. Erstelle in Lounge fürs Handy unter „Mehr“ einen neuen."

#: lounge-companion/src/server.rs
msgid "A pop-up needs a title to show."
msgstr "Ein Pop-up braucht einen Titel, den es zeigen kann."

#: lounge-companion/src/server.rs
msgid "The TV couldn't show that pop-up. Try again."
msgstr "Der Fernseher konnte dieses Pop-up nicht zeigen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "Write something to show on the TV first."
msgstr "Schreibe zuerst etwas, das auf dem Fernseher erscheinen soll."

#: lounge-companion/src/server.rs
msgid "The TV couldn't make a key. Check it has free space, then try again."
msgstr "Der Fernseher konnte keinen Schlüssel erstellen. Prüfe, ob er freien Speicher hat, und versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV couldn't remove the key. Try again."
msgstr "Der Fernseher konnte den Schlüssel nicht entfernen. Versuche es erneut."

#. the title and the line under it of a pop-up sent to the TV as a test.
#: lounge-companion/src/server.rs
msgid "This is a pop-up from your home"
msgstr "Das ist ein Pop-up aus deinem Zuhause"

#. the title and the line under it of a pop-up sent to the TV as a test.
#: lounge-companion/src/server.rs
msgid "A ring at the door would show here."
msgstr "Ein Klingeln an der Tür würde hier erscheinen."

#: lounge-companion/src/server.rs
msgid "The TV couldn't do that with the plugin. Try again."
msgstr "Der Fernseher konnte das mit dem Plugin nicht ausführen. Versuche es erneut."

#: lounge-companion/src/server.rs
msgid "The TV had already forgotten that phone."
msgstr "Der Fernseher hatte dieses Handy schon vergessen."

#: lounge-companion/src/server.rs
msgid "Forgotten, but the TV couldn't save that, so a restart could bring it back. Try again."
msgstr "Vergessen, aber der Fernseher konnte das nicht speichern; nach einem Neustart könnte es wieder da sein. Versuche es erneut."

#. "Download backup" is a button in the phone app.
#: lounge-companion/src/server.rs lounge-core/src/companion.rs
msgid "That file isn't a Lounge backup. Choose a file that Download backup saved."
msgstr "Diese Datei ist keine Lounge-Sicherung. Wähle eine Datei, die „Sicherung herunterladen“ gespeichert hat."

#. the heading and the words of the page a sign-in ends on. {plugin} is the plugin that asked for it, such as Spotify.
#: lounge-companion/src/server.rs
msgid "Signed in"
msgstr "Angemeldet"

#. the heading and the words of the page a sign-in ends on. {plugin} is the plugin that asked for it, such as Spotify.
#: lounge-companion/src/server.rs
msgid "{plugin} has what it needs. Look at the TV."
msgstr "{plugin} hat alles, was es braucht. Sieh auf den Fernseher."

#. the heading of the page a sign-in ends on when it did not go through.
#: lounge-companion/src/server.rs
msgid "Not signed in"
msgstr "Nicht angemeldet"

#: lounge-core/src/companion.rs
msgid "Lounge on the TV is restarting. Try again in a moment."
msgstr "Lounge auf dem Fernseher startet gerade neu. Versuche es gleich erneut."

#: lounge-core/src/companion.rs
msgid "The TV couldn't save that. Check it has free space, then try again."
msgstr "Der Fernseher konnte das nicht speichern. Prüfe, ob er freien Speicherplatz hat, und versuche es dann erneut."

#: lounge-core/src/companion.rs
msgid "That isn't on the TV's home screen any more. Choose it again from what the TV shows now."
msgstr "Das ist nicht mehr auf dem Startbildschirm des Fernsehers. Wähle es neu aus dem, was der Fernseher jetzt zeigt."

#: lounge-core/src/companion.rs
msgid "Couldn't open {title}. Is its app still installed?"
msgstr "{title} ließ sich nicht öffnen. Ist die zugehörige App noch installiert?"

#: lounge-core/src/companion.rs
msgid "Couldn't open that. Is its app still installed?"
msgstr "Das ließ sich nicht öffnen. Ist die zugehörige App noch installiert?"

#: lounge-core/src/companion.rs
msgid "Nothing on the TV can open that link. Install an app for it, then try again."
msgstr "Nichts auf dem Fernseher kann diesen Link öffnen. Installiere eine App dafür und versuche es dann erneut."

#: lounge-core/src/companion.rs
msgid "The TV couldn't control what is playing. Try it from the TV."
msgstr "Der Fernseher konnte nicht steuern, was gerade läuft. Versuche es direkt am Fernseher."

#: lounge-core/src/companion.rs
msgid "The TV couldn't do that. Try it from the TV."
msgstr "Der Fernseher konnte das nicht ausführen. Versuche es direkt am Fernseher."

#: lounge-core/src/companion.rs
msgid "That plugin's signature doesn't check out, so the TV won't install it. Get it again from its publisher."
msgstr "Die Signatur dieses Plugins stimmt nicht, deshalb installiert der Fernseher es nicht. Hol es dir erneut von seinem Herausgeber."

#: lounge-core/src/companion.rs
msgid "That file isn't a Lounge plugin, or it was damaged on the way. Get it again, then install it."
msgstr "Diese Datei ist kein Lounge-Plugin oder wurde unterwegs beschädigt. Hol sie dir erneut und installiere sie dann."

#: lounge-core/src/companion.rs
msgid "The phone companion is off. Turn it on, then try again."
msgstr "Lounge fürs Handy ist aus. Schalte es ein und versuche es dann erneut."

#: lounge-core/src/companion.rs
msgid "The TV isn't on a network. Connect it to your Wi-Fi, then try again."
msgstr "Der Fernseher ist in keinem Netz. Verbinde ihn mit deinem WLAN und versuche es dann erneut."

#: lounge-core/src/companion.rs
msgid "That has changed since it was shown. Close this and open it again."
msgstr "Das hat sich geändert, seit es angezeigt wurde. Schließe das hier und öffne es erneut."

#: lounge-core/src/companion.rs
msgid "The picture has no address now. Open it again."
msgstr "Das Bild hat gerade keine Adresse. Öffne es erneut."

#: lounge-core/src/companion.rs
msgid "The search is open in Lounge, but another app is still in front on the TV. Press Home to see it."
msgstr "Die Suche ist in Lounge geöffnet, aber auf dem Fernseher ist noch eine andere App im Vordergrund. Drücke Home, um die Suche zu sehen."

#: lounge-core/src/companion.rs
msgid "That plugin isn't installed any more."
msgstr "Dieses Plugin ist nicht mehr installiert."

#: lounge-core/src/companion.rs
msgid "The TV couldn't remove that plugin. Try again."
msgstr "Der Fernseher konnte dieses Plugin nicht entfernen. Versuche es erneut."

#: lounge-core/src/companion.rs
msgid "Lounge on the TV doesn't know that command. Update Lounge, then try again."
msgstr "Lounge auf dem Fernseher kennt diesen Befehl nicht. Aktualisiere Lounge und versuche es dann erneut."

#: lounge-core/src/companion.rs
msgid "Nothing on the TV is waiting for this sign-in. Start it again from the plugin's page on the TV."
msgstr "Auf dem Fernseher wartet nichts auf diese Anmeldung. Starte sie erneut auf der Seite des Plugins auf dem Fernseher."

#: lounge-core/src/companion.rs
msgid "The TV couldn't keep the sign-in. Free some space on the TV, then start it again."
msgstr "Der Fernseher konnte die Anmeldung nicht speichern. Gib auf dem Fernseher Speicherplatz frei und starte sie dann erneut."

#: lounge-core/src/companion.rs
msgid "That backup comes from a newer Lounge. Update Lounge on the TV, then restore it."
msgstr "Diese Sicherung stammt von einem neueren Lounge. Aktualisiere Lounge auf dem Fernseher und stelle sie dann wieder her."

#: lounge-core/src/companion.rs
msgid "The layout is restored, but the TV couldn't save its look and sound settings. Check it has free space, then restore again."
msgstr "Die Anordnung ist wiederhergestellt, aber der Fernseher konnte seine Einstellungen für Aussehen und Klang nicht speichern. Prüfe, ob er freien Speicherplatz hat, und stelle die Sicherung dann erneut wieder her."

#: lounge-core/src/companion.rs
msgid "That link leads back to the TV itself. Use a link to the plugin on the internet or another device."
msgstr "Dieser Link führt zurück zum Fernseher selbst. Nimm einen Link zum Plugin im Internet oder auf einem anderen Gerät."

#: lounge-core/src/companion.rs
msgid "The TV couldn't download that link. Check the address, then try again."
msgstr "Der Fernseher konnte diesen Link nicht herunterladen. Prüfe die Adresse und versuche es dann erneut."

#: lounge-core/src/engine.rs
msgid "Offline, showing what we have"
msgstr "Offline, das ist der letzte Stand"

#: lounge-core/src/engine.rs
msgid "Continue watching"
msgstr "Weiterschauen"

#: lounge-core/src/engine.rs
msgid "Your apps"
msgstr "Deine Apps"

#: lounge-core/src/engine.rs
msgid "Games"
msgstr "Spiele"

#: lounge-core/src/engine.rs
msgid "Live now"
msgstr "Jetzt live"

#: lounge-core/src/engine.rs
msgid "TV controls"
msgstr "TV-Steuerung"

#: lounge-core/src/engine.rs
msgid "Nothing yet"
msgstr "Noch nichts"

#: lounge-core/src/engine.rs
msgid "{n} app"
msgid_plural "{n} apps"
msgstr[0] "{n} App"
msgstr[1] "{n} Apps"

#. names a channel by its number when nothing more is known about it.
#: lounge-core/src/engine.rs
msgid "Channel {number}"
msgstr "Sender {number}"

#. {plugin} is a plugin's name. Its row has nothing in it yet.
#: lounge-core/src/engine.rs
msgid "{plugin}, nothing yet"
msgstr "{plugin}, noch nichts"

#. {plugin} is a plugin's name, and a title is a film, a show or the like in its row.
#: lounge-core/src/engine.rs
msgid "{plugin}, {n} title"
msgid_plural "{plugin}, {n} titles"
msgstr[0] "{plugin}, {n} Titel"
msgstr[1] "{plugin}, {n} Titel"

#: lounge-core/src/engine.rs
msgid "{n} programme"
msgid_plural "{n} programmes"
msgstr[0] "{n} Titel"
msgstr[1] "{n} Titel"

#: lounge-core/src/engine.rs
msgid "Inputs"
msgstr "Eingänge"

#. a title is a film, a show or the like. The Stage is the large area at the top of the home screen.
#: lounge-core/src/engine.rs
msgid "{n} title, all on the Stage"
msgid_plural "{n} titles, all on the Stage"
msgstr[0] "{n} Titel, auf der Bühne"
msgstr[1] "{n} Titel, alle auf der Bühne"

#: lounge-core/src/engine.rs
msgid "Nothing to continue yet"
msgstr "Noch nichts zum Weiterschauen"

#. a title is a film, a show or the like.
#: lounge-core/src/engine.rs
msgid "{n} title"
msgid_plural "{n} titles"
msgstr[0] "{n} Titel"
msgstr[1] "{n} Titel"

#. says what the Your apps row holds when no app is pinned: only the tile that opens All apps.
#: lounge-core/src/engine.rs
msgid "Only the way to All apps, until you pin one"
msgstr "Nur der Weg zu „Alle Apps“, bis du eine App anheftest"

#: lounge-core/src/engine.rs
msgid "Allow usage access in Settings to follow what you open"
msgstr "Erlaube in den Einstellungen den Zugriff auf Nutzungsdaten, damit die Reihe dem folgt, was du öffnest"

#. the apps in the Your apps row, all there because they were opened lately.
#: lounge-core/src/engine.rs
msgid "{n} app recent"
msgid_plural "{n} apps recent"
msgstr[0] "{n} App, zuletzt geöffnet"
msgstr[1] "{n} Apps, zuletzt geöffnet"

#. the apps in the Your apps row, all there because they are pinned.
#: lounge-core/src/engine.rs
msgid "{n} app, pinned only"
msgid_plural "{n} apps, pinned only"
msgstr[0] "{n} App, nur angeheftete"
msgstr[1] "{n} Apps, nur angeheftete"

#. how many apps in the Your apps row are pinned.
#: lounge-core/src/engine.rs
msgid "{n} pinned"
msgid_plural "{n} pinned"
msgstr[0] "{n} angeheftet"
msgstr[1] "{n} angeheftet"

#. how many apps in the Your apps row were opened lately.
#: lounge-core/src/engine.rs
msgid "{n} recent"
msgid_plural "{n} recent"
msgstr[0] "{n} zuletzt geöffnet"
msgstr[1] "{n} zuletzt geöffnet"

#. {pinned} is "3 pinned" and {recent} "2 recent", in your language.
#: lounge-core/src/engine.rs
msgid "{pinned}, {recent}"
msgstr "{pinned}, {recent}"

#: lounge-core/src/engine.rs
msgid "No games installed"
msgstr "Keine Spiele installiert"

#: lounge-core/src/engine.rs
msgid "{n} game"
msgid_plural "{n} games"
msgstr[0] "{n} Spiel"
msgstr[1] "{n} Spiele"

#: lounge-core/src/engine.rs
msgid "No channels yet"
msgstr "Noch keine Sender"

#: lounge-core/src/engine.rs
msgid "{n} channel"
msgid_plural "{n} channels"
msgstr[0] "{n} Sender"
msgstr[1] "{n} Sender"

#: lounge-core/src/engine.rs
msgid "No inputs found"
msgstr "Keine Eingänge gefunden"

#: lounge-core/src/engine.rs
msgid "{n} input"
msgid_plural "{n} inputs"
msgstr[0] "{n} Eingang"
msgstr[1] "{n} Eingänge"

#. stands in for a film or show whose name is gone. {app} is the app it came from.
#: lounge-core/src/engine.rs
msgid "A title {app} no longer lists"
msgstr "Ein Titel, den {app} nicht mehr führt"

#. stands in for a film or show whose name is gone.
#: lounge-core/src/engine.rs
msgid "A title that is no longer listed"
msgstr "Ein Titel, der nicht mehr geführt wird"

#: lounge-core/src/engine.rs
msgid "Plugins for your apps"
msgstr "Plugins für deine Apps"

#: lounge-core/src/engine.rs
msgid "Notifications"
msgstr "Benachrichtigungen"

#. the title of a tile with room for about 265 pixels, roughly what "Turn on TV listings" takes; the line under it says why.
#: lounge-core/src/engine.rs
msgid "Turn on notifications"
msgstr "Benachrichtigungen"

#: lounge-core/src/engine.rs
msgid "See what your apps tell you"
msgstr "Erlauben und sehen, was deine Apps melden"

#. {version} is a version number, as in "Lounge 1.2 is ready".
#: lounge-core/src/engine.rs
msgid "Lounge {version} is ready"
msgstr "Lounge {version} ist bereit"

#: lounge-core/src/engine.rs
msgid "Press to install the update"
msgstr "Drücken, um das Update zu installieren"

#. the title of a tile with room for about 265 pixels, roughly what this English takes; the line under it says why.
#: lounge-core/src/engine.rs
msgid "Turn on TV listings"
msgstr "TV-Daten erlauben"

#: lounge-core/src/engine.rs
msgid "See what you were watching"
msgstr "Sieh, was du zuletzt geschaut hast"

#. {plugin} is a plugin's name. The tile opens the plugin's page so it can be turned on.
#: lounge-core/src/engine.rs
msgid "Set up {plugin}"
msgstr "{plugin} einrichten"

#. says what turning a plugin on brings. {rows} lists the titles of its rows, as in "Adds recently added and favourites".
#: lounge-core/src/engine.rs
msgid "Adds {rows}"
msgstr "Bringt: {rows}"

#. how a row's title ends with its plugin's name, as in "Recently added on Jellyfin". That ending is left out where the plugin is already named. Keep {row} first.
#: lounge-core/src/engine.rs
msgid "{row} on {plugin}"
msgstr "{row} auf {plugin}"

#. how a row's title ends with its plugin's name, as in "Recently added on Jellyfin". That ending is left out where the plugin is already named. Keep {row} first.
#: lounge-core/src/engine.rs
msgid "{row} from {plugin}"
msgstr "{row} von {plugin}"

#. how a row's title ends with its plugin's name, as in "Recently added on Jellyfin". That ending is left out where the plugin is already named. Keep {row} first.
#: lounge-core/src/engine.rs
msgid "{row} in {plugin}"
msgstr "{row} in {plugin}"

#. the title of a small tile with room for about 140 pixels, about nine letters. Where the screen's usual name is longer, use a shorter word for it here.
#: lounge-core/src/engine.rs
msgctxt "a small tile"
msgid "All apps"
msgstr "Alle Apps"

#. the title of a small tile with room for about 140 pixels, about nine letters. Where the sheet's usual name is longer, use a shorter word for it here.
#: lounge-core/src/engine.rs
msgctxt "a small tile"
msgid "TV controls"
msgstr "Steuerung"

#. a season and an episode by number, as short as they are written, then the episode's name: "S2 E4, Honeydew".
#: lounge-core/src/engine.rs
msgid "S{season} E{episode}, {title}"
msgstr "S{season} F{episode}, {title}"

#. a season and an episode by number, as short as they are written: "S2 E4".
#: lounge-core/src/engine.rs
msgid "S{season} E{episode}"
msgstr "S{season} F{episode}"

#: lounge-core/src/engine.rs
msgid "Episode {episode}"
msgstr "Folge {episode}"

#: lounge-core/src/engine.rs
msgid "Season {season}"
msgstr "Staffel {season}"

#. {title} is the episode's name.
#: lounge-core/src/engine.rs
msgid "Season {season}, Episode {episode}: {title}"
msgstr "Staffel {season}, Folge {episode}: {title}"

#: lounge-core/src/engine.rs
msgid "Season {season}, Episode {episode}"
msgstr "Staffel {season}, Folge {episode}"

#. {title} is the episode's name.
#: lounge-core/src/engine.rs
msgid "Episode {episode}: {title}"
msgstr "Folge {episode}: {title}"

#. {title} is the name of what is on.
#: lounge-core/src/engine.rs
msgid "Season {season}: {title}"
msgstr "Staffel {season}: {title}"

#: lounge-core/src/engine.rs
msgid "All apps"
msgstr "Alle Apps"

#. "there" is the All apps screen. OK is the remote's centre button.
#: lounge-core/src/engine.rs
msgid "Hold OK on an app there to pin it"
msgstr "Halte dort OK auf einer App gedrückt, um sie anzuheften"

#. a button that opens an app or a picture.
#: lounge-core/src/engine.rs
msgid "Open"
msgstr "Öffnen"

#: lounge-core/src/engine.rs
msgid "Your TV"
msgstr "Dein Fernseher"

#: lounge-core/src/engine.rs
msgid "Turn the TV on, switch inputs and change the sound"
msgstr "Fernseher einschalten, Eingang wechseln und Ton umstellen"

#: lounge-core/src/engine.rs
msgid "Open TV controls"
msgstr "TV-Steuerung öffnen"

#. a button that goes on with what was being watched.
#: lounge-core/src/engine.rs
msgid "Continue"
msgstr "Fortsetzen"

#. a button that starts a programme, a film or a channel.
